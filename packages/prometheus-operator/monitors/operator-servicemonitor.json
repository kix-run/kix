{
  "endpoints": [
    {
      "honorLabels": true,
      "port": "https",
      "scheme": "https",
      "tlsConfig": {
        "ca": {
          "secret": {
            "key": "ca",
            "name": "prometheus-kube-prometheus-admission",
            "optional": false
          }
        },
        "serverName": "prometheus-kube-prometheus-operator"
      }
    }
  ],
  "namespaceSelector": {
    "matchNames": [
      "monitoring-system"
    ]
  },
  "selector": {
    "matchLabels": {
      "app": "kube-prometheus-stack-operator",
      "release": "prometheus"
    }
  }
}
