{
  "endpoints": [
    {
      "honorLabels": true,
      "path": "/metrics",
      "port": "http-web",
      "scheme": "http",
      "scrapeTimeout": "30s"
    }
  ],
  "jobLabel": "prometheus",
  "namespaceSelector": {
    "matchNames": [
      "monitoring-system"
    ]
  },
  "selector": {
    "matchLabels": {
      "app.kubernetes.io/instance": "prometheus",
      "app.kubernetes.io/name": "grafana"
    }
  }
}
