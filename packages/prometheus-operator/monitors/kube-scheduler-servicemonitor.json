{
  "endpoints": [
    {
      "bearerTokenFile": "/var/run/secrets/kubernetes.io/serviceaccount/token",
      "port": "http-metrics",
      "scheme": "https",
      "tlsConfig": {
        "caFile": "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt",
        "insecureSkipVerify": true
      }
    }
  ],
  "jobLabel": "jobLabel",
  "namespaceSelector": {
    "matchNames": [
      "kube-system"
    ]
  },
  "selector": {
    "matchLabels": {
      "app": "kube-prometheus-stack-kube-scheduler",
      "release": "prometheus"
    }
  }
}
