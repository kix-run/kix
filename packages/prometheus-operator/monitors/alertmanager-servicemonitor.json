{
  "endpoints": [
    {
      "enableHttp2": true,
      "path": "/metrics",
      "port": "http-web"
    },
    {
      "path": "/metrics",
      "port": "reloader-web"
    }
  ],
  "namespaceSelector": {
    "matchNames": [
      "monitoring-system"
    ]
  },
  "selector": {
    "matchLabels": {
      "app": "kube-prometheus-stack-alertmanager",
      "release": "prometheus",
      "self-monitor": "true"
    }
  }
}
