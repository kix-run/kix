            "path": "/mutate"
          }
        },
        "failurePolicy": "Fail",
        "matchPolicy": "Equivalent",
        "name": "webhook.cert-manager.io",
        "rules": [
          {
            "apiGroups": [
              "cert-manager.io"
            ],
            "apiVersions": [
              "v1"
            ],
