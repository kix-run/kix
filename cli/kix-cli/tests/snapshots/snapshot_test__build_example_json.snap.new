  {
    "apiVersion": "v1",
    "data": {
      "primary.conf": "dir /data\n# User-supplied primary configuration:\n# End of primary configuration\n",
      "replica.conf": "dir /data\n# User-supplied replica configuration:\n# End of replica configuration\n",
      "sentinel.conf": "dir \"/tmp\"\nport 26379\nsentinel monitor myprimary valkey-node-0.valkey-headless.cache.svc.cluster.local 6379 2\nsentinel down-after-milliseconds myprimary 60000\nsentinel failover-timeout myprimary 180000\nsentinel parallel-syncs myprimary 1\n# User-supplied sentinel configuration:\n# End of sentinel configuration\n",
      "valkey.conf": "# User-supplied common configuration:\n# End of common configuration\n"
    },
