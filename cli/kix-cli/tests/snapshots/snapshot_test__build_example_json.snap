  {
    "apiVersion": "stackgres.io/v1",
    "kind": "SGCluster",
    "metadata": {
      "annotations": {
        "kix.run/depends-on": "0jszdyr9p5ygryhvibaql6ihxi5w79ca,5k97q770if76zqsmhd8ylmfdlhdgljlm,awzwpm53w1kb4ysngrwmj47whaddgkih,p0cqca41q729xxcz9721a1p5d9vad5ks,requires:xaaplv5cjn51hpffkfsmxwfiv7l71abx",
        "kix.run/identity-hash": "8j59lzlswz3qm45axq0ilp5cl7kcxfhq",
        "kix.run/lifecycle": "stateful",
        "kix.run/package": "postgres",
        "kix.run/package-namespace": "immich"
      },
      "labels": {
        "app.kubernetes.io/instance": "postgres",
        "app.kubernetes.io/managed-by": "kix",
        "app.kubernetes.io/name": "stackgres-cluster",
        "app.kubernetes.io/part-of": "kix-example",
        "team": "platform"
      },
      "name": "postgres",
      "namespace": "immich"
    },
    "spec": {
      "configurations": {
        "sgPostgresConfig": "postgres-pg16-config"
      },
      "instances": 2,
      "pods": {
        "disableConnectionPooling": true,
        "persistentVolume": {
          "size": "20Gi",
          "storageClass": "lbs1-pool1-2x"
        },
        "updateStrategy": {
          "method": "ReducedImpact"
        }
      },
      "postgres": {
        "extensions": [
          {
            "name": "vector",
            "publisher": "tensorchord",
            "version": "0.3.0"
          },
          {
            "name": "vector"
          },
          {
            "name": "vchord",
            "version": "0.5.3"
          },
          {
            "name": "uuid-ossp"
          },
          {
            "name": "cube"
          },
          {
            "name": "earthdistance"
          },
          {
            "name": "unaccent"
          },
          {
            "name": "pg_trgm"
          }
        ],
        "flavor": "vanilla",
        "ssl": {
          "enabled": true
        },
        "version": "16"
      },
      "postgresServices": {
        "primary": {
          "enabled": true,
          "type": "ClusterIP"
        },
        "replicas": {
          "enabled": true,
          "type": "ClusterIP"
        }
      },
      "profile": "production",
      "replication": {
        "mode": "async",
        "role": "ha-read"
      },
      "sgInstanceProfile": "postgres-profile"
    }
  },
  {
    "apiVersion": "stackgres.io/v1",
    "kind": "SGInstanceProfile",
    "metadata": {
      "annotations": {
        "kix.run/depends-on": "awzwpm53w1kb4ysngrwmj47whaddgkih,requires:z6px32x86czzn9vwdaa4pqrf8y0f0jqp",
        "kix.run/identity-hash": "p0cqca41q729xxcz9721a1p5d9vad5ks",
        "kix.run/lifecycle": "stateful",
        "kix.run/package": "postgres",
