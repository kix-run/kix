  {
    "apiVersion": "batch/v1",
    "kind": "Job",
    "metadata": {
      "annotations": {
        "kix.run/depends-on": "awzwpm53w1kb4ysngrwmj47whaddgkih,jpmzfsa4mjzf33hm6k65l56l7j9vd1y1,nmkyq34qvmimmx5ww652blhhg57z3frg,wm2l6psdb29kqc42pj7k97q3srx3681q",
        "kix.run/hook": "post-deploy",
        "kix.run/hook-delete-policy": "before-hook-creation,hook-succeeded",
        "kix.run/identity-hash": "2himksvmpzz89m8y080x9hf63l5kamby",
        "kix.run/lifecycle": "stateful",
        "kix.run/package": "immich-db",
        "kix.run/package-namespace": "immich"
      },
      "labels": {
        "app.kubernetes.io/instance": "immich-db",
        "app.kubernetes.io/managed-by": "kix",
        "app.kubernetes.io/name": "stackgres-database",
        "app.kubernetes.io/part-of": "kix-example",
        "kix.run/db-cluster": "postgres",
        "team": "platform"
      },
      "name": "immich-db-bootstrap-55078afb92",
      "namespace": "immich"
    },
    "spec": {
      "backoffLimit": 20,
      "template": {
        "metadata": {
          "labels": {
            "app.kubernetes.io/instance": "immich-db",
            "app.kubernetes.io/name": "stackgres-database",
            "kix.run/db-cluster": "postgres"
          }
        },
        "spec": {
          "containers": [
            {
              "args": [
                "set -eu\n\necho \"waiting for postgres at $PGHOST:$PGPORT (user $PGUSER)...\"\nfor i in $(seq 1 120); do\n  if pg_isready -h \"$PGHOST\" -p \"$PGPORT\" -U \"$PGUSER\" -d postgres >/dev/null 2>&1; then\n    break\n  fi\n  sleep 2\ndone\npg_isready -h \"$PGHOST\" -p \"$PGPORT\" -U \"$PGUSER\" -d postgres\n\necho \"ensuring role \\\"immich\\\" exists with current password...\"\nROLE_EXISTS=$(psql -tAc \"SELECT 1 FROM pg_roles WHERE rolname = 'immich'\")\n# psql -c does NOT process variable substitution (:'var'); the string\n# is sent to the server as-is. Pipe SQL via stdin so psql's lexer\n# runs and substitutes :'newpw' with a properly quoted literal.\nif [ \"$ROLE_EXISTS\" = \"1\" ]; then\n  echo \"ALTER ROLE \\\"immich\\\" WITH LOGIN PASSWORD :'newpw'\" \\\n    | psql -v ON_ERROR_STOP=1 -v newpw=\"$NEW_PASSWORD\"\nelse\n  echo \"CREATE ROLE \\\"immich\\\" WITH LOGIN PASSWORD :'newpw'\" \\\n    | psql -v ON_ERROR_STOP=1 -v newpw=\"$NEW_PASSWORD\"\nfi\n\necho \"ensuring database \\\"immich\\\" exists...\"\nDB_EXISTS=$(psql -tAc \"SELECT 1 FROM pg_database WHERE datname = 'immich'\")\nif [ \"$DB_EXISTS\" != \"1\" ]; then\n  psql -v ON_ERROR_STOP=1 -c \"CREATE DATABASE \\\"immich\\\"\"\nfi\n\necho \"setting database \\\"immich\\\" owner to \\\"immich\\\"...\"\npsql -v ON_ERROR_STOP=1 -c \"ALTER DATABASE \\\"immich\\\" OWNER TO \\\"immich\\\"\"\n\n\necho \"granting privileges on \\\"immich\\\" to \\\"immich\\\"...\"\npsql -v ON_ERROR_STOP=1 \\\n  -c \"GRANT ALL PRIVILEGES ON DATABASE \\\"immich\\\" TO \\\"immich\\\"\"\n\n  echo \"ensuring extensions on \\\"immich\\\"...\"\n  psql -v ON_ERROR_STOP=1 -d \"immich\" <<'SQL'\nCREATE EXTENSION IF NOT EXISTS \"vector\" CASCADE;\nCREATE EXTENSION IF NOT EXISTS \"vchord\" CASCADE;\nCREATE EXTENSION IF NOT EXISTS \"uuid-ossp\" CASCADE;\nCREATE EXTENSION IF NOT EXISTS \"cube\" CASCADE;\nCREATE EXTENSION IF NOT EXISTS \"earthdistance\" CASCADE;\nCREATE EXTENSION IF NOT EXISTS \"unaccent\" CASCADE;\nCREATE EXTENSION IF NOT EXISTS \"pg_trgm\" CASCADE;\nSQL\n\n\necho \"stackgres-database bootstrap complete for immich@immich\"\n"
              ],
              "command": [
                "/bin/sh",
                "-c"
              ],
              "env": [
                {
                  "name": "PGHOST",
                  "value": "postgres.immich.svc.cluster.local"
                },
                {
                  "name": "PGPORT",
                  "value": "5432"
                },
                {
                  "name": "PGDATABASE",
                  "value": "postgres"
                },
                {
                  "name": "PGPASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "superuser-password",
                      "name": "postgres"
                    }
                  }
                },
                {
                  "name": "PGUSER",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "superuser-username",
                      "name": "postgres"
                    }
                  }
                },
                {
                  "name": "NEW_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "password",
                      "name": "immich-db-bootstrap-password"
                    }
                  }
                }
              ],
              "image": "postgres:16-alpine",
              "name": "bootstrap"
            }
          ],
          "restartPolicy": "OnFailure"
        }
      },
      "ttlSecondsAfterFinished": 86400
    }
  },
