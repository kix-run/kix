  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "annotations": {
        "kix.run/depends-on": "nxmwb9c04vrqlc9ry6is95js51yjybi9,rn40hbw8756809l5h5bwh65g8klv5bg3",
        "kix.run/identity-hash": "nl3i0shgglki99bd41033rjmcbmk7xn2",
        "kix.run/package": "cert-manager",
        "kix.run/package-namespace": "cert-manager"
      },
      "labels": {
        "app.kubernetes.io/component": "controller",
        "app.kubernetes.io/instance": "cert-manager",
        "app.kubernetes.io/managed-by": "kix",
        "app.kubernetes.io/name": "cert-manager",
        "app.kubernetes.io/part-of": "kix-example",
        "team": "platform"
      },
      "name": "cert-manager",
      "namespace": "cert-manager"
    },
    "spec": {
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/component": "controller",
          "app.kubernetes.io/instance": "cert-manager",
          "app.kubernetes.io/name": "cert-manager"
        }
      },
      "template": {
        "metadata": {
          "annotations": {
            "prometheus.io/path": "/metrics",
            "prometheus.io/port": "9402",
            "prometheus.io/scrape": "true"
          },
          "labels": {
            "app.kubernetes.io/component": "controller",
            "app.kubernetes.io/instance": "cert-manager",
            "app.kubernetes.io/name": "cert-manager"
          }
        },
        "spec": {
          "containers": [
            {
              "args": [
                "--v=2",
                "--cluster-resource-namespace=$(POD_NAMESPACE)",
                "--acme-http01-solver-image=quay.io/jetstack/cert-manager-acmesolver:v1.17.1",
                "--leader-election-namespace=cert-manager",
                "--max-concurrent-challenges=60"
              ],
              "env": [
                {
                  "name": "POD_NAMESPACE",
                  "valueFrom": {
                    "fieldRef": {
                      "apiVersion": "v1",
                      "fieldPath": "metadata.namespace"
                    }
                  }
                }
              ],
              "image": "quay.io/jetstack/cert-manager-controller:v1.17.1",
              "imagePullPolicy": "IfNotPresent",
              "livenessProbe": {
                "failureThreshold": 8,
                "httpGet": {
                  "path": "/livez",
                  "port": "http-healthz",
                  "scheme": "HTTP"
                },
                "initialDelaySeconds": 10,
                "periodSeconds": 10,
                "successThreshold": 1,
                "timeoutSeconds": 15
              },
              "name": "cert-manager-controller",
              "ports": [
                {
                  "containerPort": 9402,
                  "name": "http-metrics",
                  "protocol": "TCP"
                },
                {
                  "containerPort": 9403,
                  "name": "http-healthz",
                  "protocol": "TCP"
                }
              ],
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ]
                },
                "readOnlyRootFilesystem": true
              }
            }
          ],
          "enableServiceLinks": false,
          "nodeSelector": {
            "kubernetes.io/os": "linux"
          },
          "securityContext": {
            "runAsNonRoot": true,
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "serviceAccountName": "cert-manager"
        }
      }
    }
  },
