apiVersion: batch/v1
kind: Job
metadata:
  annotations:
    kix.run/depends-on: '38nagcq3syqd1pkpywrl7mawh5qknsn1,8gbrd638nd1ms66wimki92l21qqxjc8b,awzwpm53w1kb4ysngrwmj47whaddgkih,fkzl1qkjmrcp03ny7hr2sssjby480y5w'
    kix.run/identity-hash: rfm5bmkkkyhsszcwyinwndmglzsywf5m
    kix.run/lifecycle: stateful
    kix.run/package: immich-db
    kix.run/package-namespace: immich
  labels:
    app.kubernetes.io/instance: immich-db
    app.kubernetes.io/managed-by: kix
    app.kubernetes.io/name: stackgres-database
    app.kubernetes.io/part-of: kix-example
    kix.run/db-cluster: postgres
    team: platform
  name: immich-db-bootstrap-55078afb92
  namespace: immich
spec:
  backoffLimit: 20
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: immich-db
        app.kubernetes.io/name: stackgres-database
        kix.run/db-cluster: postgres
    spec:
      containers:
      - args:
        - |
          set -eu

          echo "waiting for postgres at $PGHOST:$PGPORT (user $PGUSER)..."
          for i in $(seq 1 120); do
            if pg_isready -h "$PGHOST" -p "$PGPORT" -U "$PGUSER" -d postgres >/dev/null 2>&1; then
              break
            fi
            sleep 2
          done
          pg_isready -h "$PGHOST" -p "$PGPORT" -U "$PGUSER" -d postgres

          echo "ensuring role \"immich\" exists with current password..."
          ROLE_EXISTS=$(psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = 'immich'")
          # psql -c does NOT process variable substitution (:'var'); the string
          # is sent to the server as-is. Pipe SQL via stdin so psql's lexer
          # runs and substitutes :'newpw' with a properly quoted literal.
          if [ "$ROLE_EXISTS" = "1" ]; then
            echo "ALTER ROLE \"immich\" WITH LOGIN PASSWORD :'newpw'" \
              | psql -v ON_ERROR_STOP=1 -v newpw="$NEW_PASSWORD"
          else
            echo "CREATE ROLE \"immich\" WITH LOGIN PASSWORD :'newpw'" \
              | psql -v ON_ERROR_STOP=1 -v newpw="$NEW_PASSWORD"
          fi

          echo "ensuring database \"immich\" exists..."
          DB_EXISTS=$(psql -tAc "SELECT 1 FROM pg_database WHERE datname = 'immich'")
          if [ "$DB_EXISTS" != "1" ]; then
            psql -v ON_ERROR_STOP=1 -c "CREATE DATABASE \"immich\""
          fi

          echo "setting database \"immich\" owner to \"immich\"..."
          psql -v ON_ERROR_STOP=1 -c "ALTER DATABASE \"immich\" OWNER TO \"immich\""


          echo "granting privileges on \"immich\" to \"immich\"..."
          psql -v ON_ERROR_STOP=1 \
            -c "GRANT ALL PRIVILEGES ON DATABASE \"immich\" TO \"immich\""

            echo "ensuring extensions on \"immich\"..."
            psql -v ON_ERROR_STOP=1 -d "immich" <<'SQL'
          CREATE EXTENSION IF NOT EXISTS "vector" CASCADE;
          CREATE EXTENSION IF NOT EXISTS "vchord" CASCADE;
          CREATE EXTENSION IF NOT EXISTS "uuid-ossp" CASCADE;
          CREATE EXTENSION IF NOT EXISTS "cube" CASCADE;
          CREATE EXTENSION IF NOT EXISTS "earthdistance" CASCADE;
          CREATE EXTENSION IF NOT EXISTS "unaccent" CASCADE;
          CREATE EXTENSION IF NOT EXISTS "pg_trgm" CASCADE;
          SQL


          echo "stackgres-database bootstrap complete for immich@immich"
        command:
        - /bin/sh
        - '-c'
        env:
        - name: PGHOST
          value: postgres.immich.svc.cluster.local
        - name: PGPORT
          value: '5432'
        - name: PGDATABASE
          value: postgres
        - name: PGPASSWORD
          valueFrom:
            secretKeyRef:
              key: superuser-password
              name: postgres
        - name: PGUSER
          valueFrom:
            secretKeyRef:
              key: superuser-username
              name: postgres
        - name: NEW_PASSWORD
          valueFrom:
            secretKeyRef:
              key: password
              name: immich-db-bootstrap-password
        image: postgres:16-alpine
        name: bootstrap
        securityContext:
          readOnlyRootFilesystem: true
        volumeMounts:
        - mountPath: /tmp
          name: tmp
      restartPolicy: OnFailure
      securityContext:
        runAsGroup: 999
        runAsNonRoot: true
        runAsUser: 999
      volumes:
      - emptyDir: {}
        name: tmp
  ttlSecondsAfterFinished: 86400
---
