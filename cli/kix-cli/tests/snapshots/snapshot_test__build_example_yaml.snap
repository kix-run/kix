      type: string
    - jsonPath: '.status.conditions[?(@.type=="Ready")].message'
      name: Status
      priority: 1
      type: string
    - jsonPath: '.metadata.creationTimestamp'
      name: Age
      type: date
    name: v1
    schema:
      openAPIV3Schema:
        properties:
          apiVersion:
            type: string
          kind:
            type: string
          metadata:
            type: object
          spec:
            type: object
            x-kubernetes-preserve-unknown-fields: true
