apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    kix.run/depends-on: '645lhljl77wraalwmn21nb7g6p3b2d3p,7kjfiij74j9nqb7iahry2gsqlvwpagl3,amcy3an3i9m37k3xvvkjsbrw1w5nhwrl,awzwpm53w1kb4ysngrwmj47whaddgkih,fkzl1qkjmrcp03ny7hr2sssjby480y5w,h7hhpsnd26w80pc42ymjimzjj5kf2mfg,rfm5bmkkkyhsszcwyinwndmglzsywf5m'
    kix.run/identity-hash: cvg3x4nnlskxr2zdk8axvgx8pqr51hay
    kix.run/package: immich
    kix.run/package-namespace: immich
  labels:
    app.kubernetes.io/instance: immich
    app.kubernetes.io/managed-by: kix
    app.kubernetes.io/name: immich
    app.kubernetes.io/part-of: kix-example
    team: platform
  name: immich-server
  namespace: immich
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/instance: immich
      app.kubernetes.io/name: immich
  strategy:
    type: RollingUpdate
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: immich
        app.kubernetes.io/name: immich
    spec:
      containers:
      - args:
        - |
          set -e
          REDIS_URL="ioredis://$(node -e 'const o = JSON.parse(process.env.REDIS_SENTINEL_OPTIONS); if (process.env.REDIS_PASSWORD) o.password = process.env.REDIS_PASSWORD; process.stdout.write(Buffer.from(JSON.stringify(o)).toString("base64"))')"
          export REDIS_URL
          exec start.sh
        env:
        - name: DB_DATABASENAME
          value: immich
        - name: DB_HOSTNAME
          value: postgres.immich.svc.cluster.local
        - name: DB_PORT
          value: '5432'
        - name: IMMICH_MACHINE_LEARNING_URL
          value: http://machine-learning.immich.svc.cluster.local:3003
        - name: REDIS_SENTINEL_OPTIONS
          value: '{"name":"myprimary","sentinels":[{"host":"valkey.cache.svc.cluster.local","port":"26379"}]}'
        - name: DB_PASSWORD
          valueFrom:
            secretKeyRef:
              key: password
              name: immich-db-credentials
        - name: DB_USERNAME
          valueFrom:
            secretKeyRef:
              key: username
              name: immich-db-credentials
        image: ghcr.io/immich-app/immich-server:v3.0.3
        imagePullPolicy: IfNotPresent
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /api/server/ping
            port: http
          periodSeconds: 10
          timeoutSeconds: 1
        name: immich-server
        ports:
        - containerPort: 2283
          name: http
          protocol: TCP
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /api/server/ping
            port: http
          periodSeconds: 10
          timeoutSeconds: 1
        resources:
          limits:
            cpu: '4'
            memory: '4Gi'
          requests:
            cpu: '250m'
            memory: '1Gi'
        securityContext:
          allowPrivilegeEscalation: false
          readOnlyRootFilesystem: true
        startupProbe:
          failureThreshold: 30
          httpGet:
            path: /api/server/ping
            port: http
          periodSeconds: 10
          timeoutSeconds: 1
        volumeMounts:
        - mountPath: /usr/src/app/upload
          name: storage
        - mountPath: /tmp
          name: tmp
      securityContext:
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch
        runAsGroup: 1000
        runAsNonRoot: true
        runAsUser: 1000
      terminationGracePeriodSeconds: 30
      volumes:
      - name: storage
        persistentVolumeClaim:
          claimName: storage
      - emptyDir: {}
        name: tmp
---
