    kix.dev/package-namespace: immich
  labels:
    app.kubernetes.io/instance: machineLearning
    app.kubernetes.io/managed-by: kix
    app.kubernetes.io/part-of: kix-example
    team: platform
  name: machineLearning
  namespace: immich
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/instance: machineLearning
      app.kubernetes.io/name: machineLearning
  strategy:
    type: RollingUpdate
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: machineLearning
        app.kubernetes.io/name: machineLearning
    spec:
      containers:
      - env:
        - name: HF_XET_CACHE
          value: /cache/huggingface-xet
        - name: MPLCONFIGDIR
          value: /cache/matplotlib-config
        - name: TRANSFORMERS_CACHE
          value: /cache
        image: ghcr.io/immich-app/immich-machine-learning:v2.0.0
        imagePullPolicy: IfNotPresent
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /ping
            port: http
          periodSeconds: 10
          timeoutSeconds: 1
        name: immich-machine-learning
        ports:
        - containerPort: 3003
          name: http
          protocol: TCP
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /ping
            port: http
          periodSeconds: 10
          timeoutSeconds: 1
        startupProbe:
          failureThreshold: 60
          httpGet:
            path: /ping
            port: http
          periodSeconds: 10
          timeoutSeconds: 1
        volumeMounts:
        - mountPath: /cache
          name: cache
      volumes:
      - name: cache
