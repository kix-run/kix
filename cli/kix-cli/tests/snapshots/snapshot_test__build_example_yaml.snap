apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    kix.dev/depends-on: '7jspwm7ys7xhdzgr9fagkjdm400maq4x,awzwpm53w1kb4ysngrwmj47whaddgkih,fyfgqba06ibnzdh4bxa1rpbvqsba8jq2,mq811vfzqnnfvvmf24l4h7sll6w85vl9,vzk1fh12884ayqlqxk0m1ygs94225jr3'
    kix.dev/identity-hash: isvifw38kqbsl2cdb4zbijwqji6zapxx
    kix.dev/package: immich
    kix.dev/package-namespace: immich
  labels:
    app.kubernetes.io/instance: immich
    app.kubernetes.io/managed-by: kix
    app.kubernetes.io/part-of: kix-example
    team: platform
  name: immich-server
  namespace: immich
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/instance: immich
      app.kubernetes.io/name: immich
  strategy:
    type: RollingUpdate
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: immich
        app.kubernetes.io/name: immich
    spec:
      containers:
      - env:
        - name: DB_HOSTNAME
          value: postgres.immich.svc.cluster.local
        - name: DB_PORT
          value: '5432'
        - name: IMMICH_MACHINE_LEARNING_URL
          value: http://machineLearning.immich.svc.cluster.local:3003
        - name: REDIS_HOSTNAME
          value: valkey.cache.svc.cluster.local
        image: ghcr.io/immich-app/immich-server:v2.0.0
        imagePullPolicy: IfNotPresent
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /api/server/ping
            port: http
          periodSeconds: 10
          timeoutSeconds: 1
        name: immich-server
        ports:
        - containerPort: 2283
          name: http
          protocol: TCP
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /api/server/ping
            port: http
          periodSeconds: 10
          timeoutSeconds: 1
        startupProbe:
          failureThreshold: 30
          httpGet:
            path: /api/server/ping
            port: http
          periodSeconds: 10
          timeoutSeconds: 1
        volumeMounts:
        - mountPath: /usr/src/app/upload
          name: storage
      volumes:
      - name: storage
        persistentVolumeClaim:
          claimName: storage
---
