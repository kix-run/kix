apiVersion: batch/v1
kind: Job
metadata:
  annotations:
    kix.run/depends-on: '3ggc5scpwx6q7sh71q96msgwpr1s4q2l,awzwpm53w1kb4ysngrwmj47whaddgkih,f0nc03rz9ihhhldzvmf92bjgaw6b6nsf,wpjilqis5y6l8xmx451rdcsbkpzly2na'
    kix.run/identity-hash: a30ryq1pqn4823di9xsn82dwnhh303zh
    kix.run/lifecycle: stateful
    kix.run/package: immich-db
    kix.run/package-namespace: immich
  labels:
    app.kubernetes.io/instance: immich-db
    app.kubernetes.io/managed-by: kix
    app.kubernetes.io/name: stackgres-database
    app.kubernetes.io/part-of: kix-example
    kix.run/db-cluster: postgres
    team: platform
  name: immich-db-immich-bootstrap-f2457d27ce
  namespace: immich
spec:
  backoffLimit: 20
  template:
    metadata:
      labels:
        app.kubernetes.io/instance: immich-db
        app.kubernetes.io/name: stackgres-database
        kix.run/db-cluster: postgres
    spec:
      containers:
      - args:
        - |
          set -eu

          echo "waiting for postgres at $PGHOST:$PGPORT (user $PGUSER)..."
          for i in $(seq 1 120); do
            if pg_isready -h "$PGHOST" -p "$PGPORT" -U "$PGUSER" -d postgres >/dev/null 2>&1; then
              break
            fi
            sleep 2
          done
          pg_isready -h "$PGHOST" -p "$PGPORT" -U "$PGUSER" -d postgres

          echo "ensuring role \"immich\" exists with current password..."
          ROLE_EXISTS=$(psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = 'immich'")
          # psql -c sends its string without variable substitution, so the
          # statement goes through stdin, where psql substitutes :'newpw'.
          if [ "$ROLE_EXISTS" = "1" ]; then
            echo "ALTER ROLE \"immich\" WITH LOGIN PASSWORD :'newpw'" \
              | psql -v ON_ERROR_STOP=1 -v newpw="$NEW_PASSWORD"
          else
            echo "CREATE ROLE \"immich\" WITH LOGIN PASSWORD :'newpw'" \
              | psql -v ON_ERROR_STOP=1 -v newpw="$NEW_PASSWORD"
          fi

          echo "ensuring database \"immich\" exists..."
          DB_EXISTS=$(psql -tAc "SELECT 1 FROM pg_database WHERE datname = 'immich'")
          if [ "$DB_EXISTS" != "1" ]; then
            psql -v ON_ERROR_STOP=1 -c "CREATE DATABASE \"immich\""
          fi

          echo "setting database \"immich\" owner to \"immich\"..."
          psql -v ON_ERROR_STOP=1 -c "ALTER DATABASE \"immich\" OWNER TO \"immich\""


          echo "granting privileges on \"immich\" to \"immich\"..."
          psql -v ON_ERROR_STOP=1 \
            -c "GRANT ALL PRIVILEGES ON DATABASE \"immich\" TO \"immich\""

            echo "ensuring extensions on \"immich\"..."
            psql -v ON_ERROR_STOP=1 -d "immich" <<'SQL'
          CREATE EXTENSION IF NOT EXISTS "vchord" CASCADE;
          CREATE EXTENSION IF NOT EXISTS "uuid-ossp" CASCADE;
          CREATE EXTENSION IF NOT EXISTS "cube" CASCADE;
          CREATE EXTENSION IF NOT EXISTS "earthdistance" CASCADE;
          CREATE EXTENSION IF NOT EXISTS "unaccent" CASCADE;
          CREATE EXTENSION IF NOT EXISTS "pg_trgm" CASCADE;
          SQL


          echo "stackgres-database bootstrap complete for immich@immich"
        command:
        - /bin/sh
        - '-c'
        env:
        - name: PGHOST
          value: postgres.immich.svc.cluster.local
        - name: PGPORT
          value: '5432'
        - name: PGDATABASE
          value: postgres
        - name: PGPASSWORD
          valueFrom:
            secretKeyRef:
              key: superuser-password
              name: postgres
        - name: PGUSER
          valueFrom:
            secretKeyRef:
              key: superuser-username
              name: postgres
        - name: NEW_PASSWORD
          valueFrom:
            secretKeyRef:
              key: password
              name: immich-db-immich-bootstrap-password
        image: docker.io/library/postgres:18.6-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
        name: bootstrap
        resources:
          limits:
            cpu: '500m'
            memory: '128Mi'
          requests:
            cpu: '10m'
            memory: '32Mi'
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
        volumeMounts:
        - mountPath: /tmp
          name: tmp
      restartPolicy: OnFailure
      securityContext:
        runAsGroup: 70
        runAsNonRoot: true
        runAsUser: 70
        seccompProfile:
          type: RuntimeDefault
      volumes:
      - emptyDir: {}
        name: tmp
  ttlSecondsAfterFinished: 86400
---
apiVersion: batch/v1
kind: Job
metadata:
  annotations:
    kix.run/depends-on: mm65yrp340h4r5hkffcskpnagv1fngrx,vj02x4vxyqf0xy0834sc3siril473nmn,requires:gpgc770viyqvwsxca5k1pppb26m1rimb,requires:wsqnhv3pgyba90gh729nk7s0xg60880c,requires:2x5vwc8jz0p3lpx1ky9hnkvh1f8sxaki,requires:yf45xwxqrvkxjj9qa8i62i9cxyw62gqp,requires:pn55pw3pvihnd2wa7s33fcd01grnxj8k,requires:pgiw1h58mm2dmc4ydr2jh8f1qz4kkwkz,requires:lk9kdi4lwn9wbjngvq9gp4n9fwjzxkph,requires:5kd6wirwlqsnz73rw163g301xb4jhqaw,requires:4yay32l4ir5vlpf6hx2sj68lnysnj1hb
    kix.run/identity-hash: bk8g7nkk4svp38xinv2br6awbk5i9arh
    kix.run/package: stackgres-operator
    kix.run/package-namespace: stackgres-system
    kix.run/rerun: on-change
  labels:
    app: stackgres-operator-webhook-check
    app.kubernetes.io/instance: stackgres-operator
    app.kubernetes.io/managed-by: kix
    app.kubernetes.io/part-of: kix-example
    team: platform
  name: stackgres-operator-webhook-check
  namespace: stackgres-system
spec:
  backoffLimit: 1
  template:
    metadata:
      labels:
        app: stackgres-operator-webhook-check
    spec:
      containers:
      - command:
        - /bin/bash
        - '-c'
        - |
          set -u
          check() {
            for type in mutating validating; do
              entries=$(kubectl get "${type}webhookconfiguration" stackgres-operator -o 'jsonpath={.webhooks[*].name}') || return 1
              case " $entries " in
                *" sgcluster.${type}-webhook.stackgres.io "*) ;;
                *) echo "${type}webhookconfiguration/stackgres-operator has no SGCluster entry yet"; return 1 ;;
              esac
            done
            version=$(echo '{"apiVersion":"stackgres.io/v1","kind":"SGInstanceProfile","metadata":{"generateName":"stackgres-operator-webhook-check-","namespace":"stackgres-system"},"spec":{"cpu":"1","memory":"1Gi"}}' | kubectl create --dry-run=server -o 'jsonpath={.metadata.annotations.stackgres\.io/operatorVersion}' -f -) || return 1
            if [ -z "$version" ]; then
              echo "the dry-run SGInstanceProfile came back without the mutating webhook's annotation"
              return 1
            fi
            echo "the StackGres 1.19.2 admission webhooks are serving (operatorVersion $version)"
          }
          deadline=$((SECONDS + 120))
          until check; do
            if [ "$SECONDS" -ge "$deadline" ]; then
              echo "the StackGres admission webhooks did not serve within 120 s; see the logs of deployment/stackgres-operator in stackgres-system"
              exit 1
            fi
            sleep 2
          done
        env:
        - name: HOME
          value: /tmp
        image: quay.io/ongres/kubectl:v1.37.1-build-6.56@sha256:8e3f36d49e403423627b450d803c94cf93c8bbebae8f59b11cb5e458bb0c1a39
        imagePullPolicy: IfNotPresent
        name: webhook-check
        resources:
          limits:
            cpu: '200m'
            memory: '128Mi'
          requests:
            cpu: '10m'
            memory: '32Mi'
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
        volumeMounts:
        - mountPath: /tmp
          name: tmp
      enableServiceLinks: false
      restartPolicy: Never
      securityContext:
        runAsGroup: 1000
        runAsNonRoot: true
        runAsUser: 1000
        seccompProfile:
          type: RuntimeDefault
      serviceAccountName: stackgres-operator-webhook-check
      volumes:
      - emptyDir: {}
        name: tmp
---
