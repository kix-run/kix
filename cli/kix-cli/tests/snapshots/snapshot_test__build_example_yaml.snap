apiVersion: stackgres.io/v1
kind: SGCluster
metadata:
  annotations:
    kix.run/depends-on: '5k97q770if76zqsmhd8ylmfdlhdgljlm,5vv0jmq2kn7kdaafxwch36lk1xdy729g,awzwpm53w1kb4ysngrwmj47whaddgkih,hq7b20hbqg6256fcryd8hiy9kx8p1ajc,requires:635sp4snjvk1ckmz3d9blgmnbdmd8ndd'
    kix.run/identity-hash: qfc2lirkd8vpx9skfckl5x8n5zcq1sbf
    kix.run/lifecycle: stateful
    kix.run/package: postgres
    kix.run/package-namespace: immich
    kix.run/readiness: '{"condition":{"status":"True","type":"Bootstrapped"}}'
  labels:
    app.kubernetes.io/instance: postgres
    app.kubernetes.io/managed-by: kix
    app.kubernetes.io/name: stackgres-cluster
    app.kubernetes.io/part-of: kix-example
    team: platform
  name: postgres
  namespace: immich
spec:
  configurations:
    sgPostgresConfig: postgres-pg16-config
  instances: 2
  pods:
    disableConnectionPooling: true
    persistentVolume:
      size: '20Gi'
      storageClass: lbs1-pool1-2x
    updateStrategy:
      method: ReducedImpact
  postgres:
    extensions:
    - name: vector
      publisher: tensorchord
      version: '0.3.0'
    - name: vector
    - name: vchord
      version: '0.5.3'
    - name: uuid-ossp
    - name: cube
    - name: earthdistance
    - name: unaccent
    - name: pg_trgm
    flavor: vanilla
    ssl:
      enabled: true
    version: '16'
  postgresServices:
    primary:
      enabled: true
      type: ClusterIP
    replicas:
      enabled: true
      type: ClusterIP
  profile: production
  replication:
    mode: async
    role: ha-read
  sgInstanceProfile: postgres-profile
---
apiVersion: stackgres.io/v1
kind: SGInstanceProfile
metadata:
  annotations:
    kix.run/depends-on: awzwpm53w1kb4ysngrwmj47whaddgkih,requires:iaad55zf38r3fmb8d17az0mm2wzbyy6l
    kix.run/identity-hash: '5vv0jmq2kn7kdaafxwch36lk1xdy729g'
    kix.run/lifecycle: stateful
    kix.run/package: postgres
    kix.run/package-namespace: immich
  labels:
    app.kubernetes.io/instance: postgres
    app.kubernetes.io/managed-by: kix
    app.kubernetes.io/name: stackgres-cluster
    app.kubernetes.io/part-of: kix-example
    team: platform
  name: postgres-profile
  namespace: immich
spec:
  cpu: '1'
  memory: '2Gi'
---
apiVersion: stackgres.io/v1
kind: SGPostgresConfig
metadata:
  annotations:
    kix.run/depends-on: awzwpm53w1kb4ysngrwmj47whaddgkih,requires:2bq7pswvipdyba718hp3wbi69nxw1j15
    kix.run/identity-hash: hq7b20hbqg6256fcryd8hiy9kx8p1ajc
    kix.run/lifecycle: stateful
    kix.run/package: postgres
    kix.run/package-namespace: immich
  labels:
    app.kubernetes.io/instance: postgres
    app.kubernetes.io/managed-by: kix
    app.kubernetes.io/name: stackgres-cluster
    app.kubernetes.io/part-of: kix-example
    team: platform
  name: postgres-pg16-config
  namespace: immich
spec:
  postgresVersion: '16'
  postgresql.conf:
    autovacuum_max_workers: '3'
    autovacuum_vacuum_cost_delay: '2ms'
    autovacuum_vacuum_scale_factor: '0.04'
    autovacuum_work_mem: '512MB'
    checkpoint_completion_target: '0.9'
    checkpoint_timeout: '15min'
    default_statistics_target: '100'
    default_toast_compression: lz4
    effective_cache_size: '1536MB'
    effective_io_concurrency: '200'
    enable_partitionwise_aggregate: 'on'
    enable_partitionwise_join: 'on'
    huge_pages: 'off'
    jit_inline_above_cost: '-1'
    lc_monetary: C.UTF-8
    lc_numeric: C.UTF-8
    lc_time: C.UTF-8
    log_autovacuum_min_duration: '0ms'
    log_checkpoints: 'on'
    log_connections: 'on'
    log_disconnections: 'on'
    log_line_prefix: '%t [%p]: db=%d,user=%u,app=%a,client=%h '
    log_lock_waits: 'on'
    log_min_duration_statement: '1s'
    log_statement: none
    log_temp_files: '0kB'
    maintenance_work_mem: '128MB'
    max_connections: '200'
    max_locks_per_transaction: '128'
    max_parallel_maintenance_workers: '1'
    max_parallel_workers: '2'
    max_parallel_workers_per_gather: '1'
    max_pred_locks_per_transaction: '128'
    max_prepared_transactions: '32'
    max_replication_slots: '20'
    max_wal_senders: '20'
    max_wal_size: '4GB'
    max_worker_processes: '2'
    min_wal_size: '1GB'
    pg_stat_statements.track_utility: 'off'
    random_page_cost: '1.1'
    shared_buffers: '512MB'
    shared_preload_libraries: pg_stat_statements, auto_explain, vchord
    superuser_reserved_connections: '8'
    timescaledb.license: timescale
    track_activity_query_size: '4kB'
    track_commit_timestamp: 'on'
    track_functions: pl
    track_io_timing: 'on'
    vacuum_cost_limit: '400'
    wal_buffers: '16MB'
    wal_keep_size: '1536MB'
    work_mem: '100MB'
---
allowVolumeExpansion: true
