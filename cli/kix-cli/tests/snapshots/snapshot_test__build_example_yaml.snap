apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    kix.run/depends-on: rn40hbw8756809l5h5bwh65g8klv5bg3,vjrwgvi1gsi0lqmgz1iifkr5jdalp91l
    kix.run/identity-hash: '1vk2gibwszq9plnp07ax8ks6xajvm58h'
    kix.run/package: cert-manager
    kix.run/package-namespace: cert-manager
  labels:
