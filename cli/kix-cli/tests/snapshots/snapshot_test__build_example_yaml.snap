apiVersion: stackgres.io/v1
kind: SGCluster
metadata:
  annotations:
    kix.dev/depends-on: '5k97q770if76zqsmhd8ylmfdlhdgljlm,awzwpm53w1kb4ysngrwmj47whaddgkih,ccnkymzg254kbvzkwjf32bl051i59pby,cvgh3gz7zijfr2kbrsjx3y9mlp3g302s'
    kix.dev/identity-hash: fyfgqba06ibnzdh4bxa1rpbvqsba8jq2
    kix.dev/package: postgres
    kix.dev/package-namespace: immich
  labels:
    app.kubernetes.io/instance: postgres
    app.kubernetes.io/managed-by: kix
    app.kubernetes.io/name: stackgres-cluster
    app.kubernetes.io/part-of: kix-example
    team: platform
  name: postgres
  namespace: immich
spec:
  configurations:
    sgPostgresConfig: postgres-pg16-config
  instances: 2
  pods:
    persistentVolume:
      size: '20Gi'
      storageClass: lbs1-pool1-2x
  postgres:
    extensions:
    - name: vectors
      publisher: tensorchord
      repository: https://extensions.stackgres.io/postgres/repository
      version: '0.4.0'
    flavor: vanilla
    ssl:
      enabled: true
    version: '16'
  postgresServices:
    primary:
      enabled: true
      type: ClusterIP
    replicas:
      enabled: true
      type: ClusterIP
  profile: production
  prometheusAutobind: true
  replication:
    mode: async
    role: ha-read
  sgInstanceProfile: postgres-profile
