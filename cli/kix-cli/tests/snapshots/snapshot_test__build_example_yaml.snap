    kix.run/depends-on: '6s2slwya8aj926h7j1s0n5rjhp0lzp1l,8lyd5p4pzpm38hj099zz021h131c02jy,awzwpm53w1kb4ysngrwmj47whaddgkih,pnp59yfhnv6byw601crmpvk6sippsnyr,requires:bk8g7nkk4svp38xinv2br6awbk5i9arh,requires:ax0ravwlg79b6irbwpdl9mm7gq5an367,requires:q4zbl6p5zm8d373lqlx9amq9lv5xlz0z'
    kix.run/identity-hash: qckgnn11h3i4wmdd55h76599virqbhqc
    kix.run/lifecycle: stateful
    kix.run/package: postgres
    kix.run/package-namespace: immich
    kix.run/readiness: '{"condition":{"status":"True","type":"Bootstrapped"}}'
  labels:
    app.kubernetes.io/instance: postgres
    app.kubernetes.io/managed-by: kix
    app.kubernetes.io/part-of: kix-example
    team: platform
  name: postgres
  namespace: immich
spec:
  configurations:
    sgPostgresConfig: postgres-pg17-config
  instances: 2
  pods:
    disableConnectionPooling: true
    persistentVolume:
      size: '20Gi'
      storageClass: local-path
    scheduling:
      topologySpreadConstraints:
      - labelSelector:
          matchLabels:
            app: StackGresCluster
            stackgres.io/cluster-name: postgres
        maxSkew: 1
        nodeTaintsPolicy: Honor
        topologyKey: kubernetes.io/hostname
        whenUnsatisfiable: DoNotSchedule
  postgres:
    extensions:
    - name: vchord
      version: '0.5.3'
    - name: uuid-ossp
    - name: cube
    - name: earthdistance
    - name: unaccent
    - name: pg_trgm
    - name: vector
    version: '17'
  sgInstanceProfile: postgres-profile
---
