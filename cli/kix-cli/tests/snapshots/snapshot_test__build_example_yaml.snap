---
apiVersion: v1
data:
  lib.sh: |
    # Shared by the start and preStop scripts. Every value comes from the
    # container's environment, which the package sets:
    #   VALKEY_PORT, SENTINEL_PORT   ports of valkey-server and Sentinel
    #   HEADLESS_FQDN                the headless Service (Sentinel only)
    #   VALKEY_REPLICAS              StatefulSet replicas (Sentinel only)
    #   PRIMARY_SET                  the name Sentinel monitors (Sentinel only)
    #   POD_NAME                     this pod's name, <statefulset>-<ordinal>

    # Pod ordinal and the stable DNS name of pod N. The headless Service
    # publishes unready addresses, so a peer resolves before it is Ready.
    ordinal=${POD_NAME##*-}
    peer() {
        echo "${POD_NAME%-*}-$1.$HEADLESS_FQDN"
    }
    SELF=${HEADLESS_FQDN:+$(peer "$ordinal")}

    # A config-file string holding $1 byte for byte: double quotes around a
    # \xHH escape per byte, which valkey.conf and sentinel.conf decode. Line
    # breaks, quotes, and a trailing newline from a Secret written with echo
    # stay part of the value, as they do for clients reading the same Secret.
    # Write it with printf: dash's echo expands backslash escapes.
    conf_quote() {
        printf '"%s"' "$(printf '%s' "$1" | od -An -v -tx1 | tr -d ' \n' | sed 's/../\\x&/g')"
    }

    # Prints "host port" of the primary as the first Sentinel of another pod
    # reports it, or fails when none answers. Sentinel's default user takes no
    # password, and an AUTH with one is an error, so the password variable is
    # dropped for these calls.
    ask_sentinels() {
        i=0
        while [ "$i" -lt "$VALKEY_REPLICAS" ]; do
            if [ "$i" != "$ordinal" ]; then
                answer=$(env -u REDISCLI_AUTH timeout 5 valkey-cli -h "$(peer "$i")" -p "$SENTINEL_PORT" \
                    SENTINEL get-primary-addr-by-name "$PRIMARY_SET" 2>/dev/null | tr '\n' ' ')
                # shellcheck disable=SC2086 # split the reply into host and port
                set -- $answer
                if [ "$#" -eq 2 ]; then
                    echo "$1 $2"
                    return 0
                fi
            fi
            i=$((i + 1))
        done
        return 1
    }

    # Prints "host port" of the primary. When no other Sentinel answers within
    # three tries, this is a first start or a restart after every pod stopped,
    # and pod 0 is the primary.
    find_primary() {
        for _ in 1 2 3; do
            if ask_sentinels; then
                return 0
            fi
            sleep 2
        done
        echo "$(peer 0) $VALKEY_PORT"
    }

    # The primary the local Sentinel reports, host only.
    local_sentinel_primary() {
        env -u REDISCLI_AUTH timeout 3 valkey-cli -p "$SENTINEL_PORT" \
            SENTINEL get-primary-addr-by-name "$PRIMARY_SET" 2>/dev/null | head -n 1
    }

    # Waits until the local Sentinel reports a primary other than this pod.
    # Gives up once the clock passes $1 (seconds since the epoch); the last
    # check can end up to 4s later.
    wait_primary_moved() {
        while [ "$(date +%s)" -lt "$1" ]; do
            current=$(local_sentinel_primary)
            if [ -n "$current" ] && [ "$current" != "$SELF" ]; then
                return 0
            fi
            sleep 1
        done
        return 1
    }
  prestop.sh: |
    #!/bin/sh
    # preStop hooks of the Sentinel topology. $1 is the container:
    #   valkey    when this pod is the primary, pause writes and ask Sentinel to
    #             fail over, then wait for another pod to take over
    #   sentinel  wait for the same condition, so the local Sentinel outlives
    #             the valkey hook
    # Both stop waiting 25s after the hook starts. The kubelet stops a hook
    # that is still running when the pod's termination grace period ends.
    set -u
    . /opt/valkey/lib.sh

    deadline=$(($(date +%s) + 25))

    # The kubelet records a hook's own output only when the hook fails, so the
    # messages go to the stderr of the container's main process, which is the
    # container log.
    log() {
        echo "prestop: $*" 2>/dev/null >/proc/1/fd/2
    }

    case "$1" in
    valkey)
        role=$(timeout 3 valkey-cli -p "$VALKEY_PORT" ROLE 2>/dev/null | head -n 1)
        [ "$role" = master ] || exit 0
        log "this pod is the primary; failing over"
        timeout 3 valkey-cli -p "$VALKEY_PORT" CLIENT PAUSE 22000 WRITE >/dev/null
        reply=$(timeout 5 valkey-cli -p "$SENTINEL_PORT" --user sentinel-admin \
            SENTINEL FAILOVER "$PRIMARY_SET" 2>&1)
        if [ "$reply" != OK ]; then
            log "Sentinel did not start a failover: $reply"
            timeout 3 valkey-cli -p "$VALKEY_PORT" CLIENT UNPAUSE >/dev/null
        elif wait_primary_moved "$deadline"; then
            log "$(local_sentinel_primary) is the primary"
        else
            log "no other pod became the primary in time"
        fi
        ;;
    sentinel)
        [ "$(local_sentinel_primary)" = "$SELF" ] || exit 0
        wait_primary_moved "$deadline" || true
        ;;
    esac
    exit 0
  probe.sh: |
    #!/bin/sh
    # Container probes. $1 is the mode:
    #   liveness   valkey-server answers PONG, or is loading its dataset
    #              (LOADING) or is a replica without a primary (MASTERDOWN)
    #   readiness  valkey-server answers PONG
    #   sentinel   Sentinel answers PONG
    set -u

    case "$1" in
    sentinel)
        reply=$(env -u REDISCLI_AUTH timeout 3 valkey-cli -p "$SENTINEL_PORT" ping 2>&1)
        ;;
    *)
        reply=$(timeout 3 valkey-cli -p "$VALKEY_PORT" ping 2>&1)
        ;;
    esac

    case "$1:$reply" in
    *:PONG) exit 0 ;;
    liveness:*LOADING* | liveness:*MASTERDOWN*) exit 0 ;;
    esac
    echo "$reply"
    exit 1
  sentinel.conf: |
    sentinel down-after-milliseconds primary 60000
    sentinel failover-timeout primary 180000
    sentinel parallel-syncs primary 1
  start-sentinel.sh: |
    #!/bin/sh
    # Writes sentinel.conf into the writable /sentinel volume (Sentinel rewrites
    # its own config as state changes) and starts Sentinel on it.
    #
    # Sentinel's default user may read Sentinel's state (the primary, its
    # replicas, and the other Sentinels) and nothing else, so a client that
    # reaches port 26379 without the password can discover the primary but
    # cannot reconfigure Sentinel. Client libraries ask in different ways:
    # redis-py lists every primary with SENTINEL MASTERS, others ask for one
    # address. The sentinel-admin user, with the instance password, runs every
    # command; the Sentinels use it with each other and the preStop hook uses
    # it to fail over.
    set -eu
    . /opt/valkey/lib.sh

    # shellcheck disable=SC2046 # split "host port"
    set -- $(find_primary)
    primary_host=$1
    primary_port=$2
    echo "sentinel: monitoring $primary_host:$primary_port" >&2

    password=$(conf_quote "$VALKEY_PASSWORD")
    password_hash=$(printf '%s' "$VALKEY_PASSWORD" | sha256sum | cut -d ' ' -f 1)
    # A restarted pod keeps its Sentinel identity, so its peers do not count it
    # twice.
    myid=$(printf '%s' "$POD_NAME" | sha1sum | cut -d ' ' -f 1)

    conf=/sentinel/sentinel.conf
    umask 077
    {
        echo "port $SENTINEL_PORT"
        echo "dir /sentinel"
        echo "sentinel resolve-hostnames yes"
        echo "sentinel announce-hostnames yes"
        echo "sentinel announce-ip $SELF"
        echo "sentinel announce-port $SENTINEL_PORT"
        echo "sentinel myid $myid"
        echo "user default on nopass allchannels -@all +ping +auth +hello +client|setname +client|getname +client|setinfo +role +info +subscribe +psubscribe +unsubscribe +punsubscribe +sentinel|get-primary-addr-by-name +sentinel|get-master-addr-by-name +sentinel|primaries +sentinel|masters +sentinel|primary +sentinel|master +sentinel|sentinels +sentinel|replicas +sentinel|slaves"
        echo "user sentinel-admin on #$password_hash ~* &* +@all"
        echo "sentinel sentinel-user sentinel-admin"
        printf 'sentinel sentinel-pass %s\n' "$password"
        echo "sentinel monitor $PRIMARY_SET $primary_host $primary_port $SENTINEL_QUORUM"
        printf 'sentinel auth-pass %s %s\n' "$PRIMARY_SET" "$password"
        cat /opt/valkey/sentinel.conf
    } >"$conf.tmp"
    mv "$conf.tmp" "$conf"
    exec valkey-sentinel "$conf"
  start-valkey.sh: |
    #!/bin/sh
    # Writes the runtime valkey.conf and starts valkey-server on it. The
    # password goes into the file, not argv, because /proc/<pid>/cmdline is
    # readable by every process in the container. REDISCLI_AUTH holds it.
    set -eu
    . /opt/valkey/lib.sh

    if [ -z "$REDISCLI_AUTH" ]; then
        echo "valkey: key password of the valkeyPassword secret is empty, and requirepass \"\" would turn authentication off; set a password" >&2
        exit 1
    fi
    password=$(conf_quote "$REDISCLI_AUTH")
    conf=/run/valkey/valkey.conf
    umask 077
    {
        echo "include /opt/valkey/valkey.conf"
        echo "port $VALKEY_PORT"
        echo "dir /data"
        printf 'requirepass %s\nprimaryauth %s\n' "$password" "$password"
        if [ "$SENTINEL_ENABLED" = yes ]; then
            echo "replica-announce-ip $SELF"
            echo "replica-announce-port $VALKEY_PORT"
            # shellcheck disable=SC2046 # split "host port"
            set -- $(find_primary)
            if [ "$1" = "$SELF" ]; then
                echo "valkey: starting as the primary" >&2
            else
                echo "valkey: starting as a replica of $1:$2" >&2
                echo "replicaof $1 $2"
            fi
        fi
    } >"$conf.tmp"
    mv "$conf.tmp" "$conf"
    exec valkey-server "$conf"
  valkey.conf: |
    appendonly yes
    maxmemory 375809638
