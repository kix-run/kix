kind: Deployment
metadata:
  annotations:
    kix.dev/depends-on: awzwpm53w1kb4ysngrwmj47whaddgkih
    kix.dev/identity-hash: '03gyz7mxzsav8vl9qjh6y3mqbak9ybni'
