  namespace: cert-manager
---
apiVersion: v1
kind: ServiceAccount
metadata:
  annotations:
    kix.dev/depends-on: sj0fv5bs2hnh9zcqdh62ph34l2wm0b1m
    kix.dev/identity-hash: '44maq4n7lnfk8ixwlhk4i1xzbik7fliy'
    kix.dev/package: coredns
    kix.dev/package-namespace: kube-system
  labels:
    app.kubernetes.io/instance: coredns
    app.kubernetes.io/managed-by: kix
