            command:
            - sh
            - '-c'
            - /health/ping_sentinel.sh 5
          failureThreshold: 22
          initialDelaySeconds: 10
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 5
        volumeMounts:
        - mountPath: /data
          name: valkey-data
        - mountPath: /health
          name: health
        - mountPath: /opt/bitnami/scripts/start-scripts
          name: start-scripts
        - mountPath: /opt/bitnami/valkey-sentinel/etc
