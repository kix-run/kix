    kix.run/identity-hash: '11hh6hfm8rhpdnyqfd2lcdahwif5s62s'
    kix.run/package: immich
    kix.run/package-namespace: immich
  labels:
    app.kubernetes.io/instance: immich
    app.kubernetes.io/managed-by: kix
    app.kubernetes.io/name: immich
    app.kubernetes.io/part-of: kix-example
    team: platform
  name: immich-server
  namespace: immich
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/instance: immich
      app.kubernetes.io/name: immich
  strategy:
    type: Recreate
  template:
    metadata:
      annotations:
        checksum/database: '5cawlan7m3q20lrmwam726m9mgq3irzl'
        checksum/valkey-password: k7x17sc733q2jxarkgk3x95hi9il1m2l
      labels:
        app.kubernetes.io/instance: immich
        app.kubernetes.io/name: immich
    spec:
      automountServiceAccountToken: false
      containers:
      - args:
        - |
          set -e
          REDIS_URL="ioredis://$(node -e 'const o = JSON.parse(process.env.REDIS_SENTINEL_OPTIONS); if (process.env.REDIS_PASSWORD) o.password = process.env.REDIS_PASSWORD; process.stdout.write(Buffer.from(JSON.stringify(o)).toString("base64"))')"
          export REDIS_URL
          exec start.sh
        env:
        - name: DB_DATABASE_NAME
          value: immich
        - name: DB_HOSTNAME
          value: postgres.immich.svc.cluster.local
        - name: DB_PASSWORD
          valueFrom:
            secretKeyRef:
              key: password
              name: immich-db-credentials
        - name: DB_PORT
          value: '5432'
        - name: DB_USERNAME
          valueFrom:
            secretKeyRef:
              key: username
              name: immich-db-credentials
        - name: DB_VECTOR_EXTENSION
          value: vectorchord
        - name: IMMICH_MACHINE_LEARNING_URL
          value: http://machine-learning.immich.svc.cluster.local:3003
        - name: IMMICH_MEDIA_LOCATION
          value: /usr/src/app/upload
        - name: REDIS_PASSWORD
          valueFrom:
            secretKeyRef:
              key: password
              name: valkey-password
        - name: REDIS_SENTINEL_OPTIONS
          value: '{"name":"primary","sentinels":[{"host":"valkey.immich.svc.cluster.local","port":"26379"}]}'
        image: ghcr.io/immich-app/immich-server:v3.0.3@sha256:c716dc20f957aafd89fa9d284a2ec63e25c9e2d8d8e87c6197d540a3dce237db
        imagePullPolicy: IfNotPresent
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /api/server/ping
            port: http
          periodSeconds: 10
          timeoutSeconds: 1
        name: immich-server
        ports:
        - containerPort: 2283
          name: http
          protocol: TCP
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /api/server/ping
            port: http
          periodSeconds: 10
          timeoutSeconds: 1
        resources:
          limits:
            cpu: '4'
            memory: '4Gi'
          requests:
            cpu: '250m'
            memory: '1Gi'
        securityContext:
          allowPrivilegeEscalation: false
          capabilities:
            drop:
            - ALL
          readOnlyRootFilesystem: true
        startupProbe:
          failureThreshold: 30
          httpGet:
            path: /api/server/ping
            port: http
          periodSeconds: 10
          timeoutSeconds: 1
        volumeMounts:
        - mountPath: /usr/src/app/upload
          name: storage
        - mountPath: /tmp
          name: tmp
      securityContext:
        fsGroup: 1000
        fsGroupChangePolicy: OnRootMismatch
        runAsGroup: 1000
        runAsNonRoot: true
        runAsUser: 1000
        seccompProfile:
          type: RuntimeDefault
      terminationGracePeriodSeconds: 30
      volumes:
      - name: storage
        persistentVolumeClaim:
          claimName: storage
      - emptyDir:
          sizeLimit: '1Gi'
        name: tmp
