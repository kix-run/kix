apiVersion: stackgres.io/v1
kind: SGPostgresConfig
metadata:
  annotations:
    kix.dev/depends-on: awzwpm53w1kb4ysngrwmj47whaddgkih
    kix.dev/identity-hash: ccnkymzg254kbvzkwjf32bl051i59pby
