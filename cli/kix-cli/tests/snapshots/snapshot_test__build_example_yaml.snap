apiVersion: apps/v1
kind: Deployment
metadata:
  annotations:
    kix.dev/depends-on: '4ak8378030wih6g0bb1kx0vzlhkrz5ym,mm65yrp340h4r5hkffcskpnagv1fngrx'
    kix.dev/identity-hash: qm1cs3aqyy8l96ix39cjc6f7dsa5spzv
    kix.dev/package: stackgres-operator
    kix.dev/package-namespace: stackgres-system
  labels:
    app: stackgres-operator
    app.kubernetes.io/instance: stackgres-operator
    app.kubernetes.io/managed-by: kix
    app.kubernetes.io/part-of: kix-example
    group: stackgres.io
    team: platform
    version: '1.16.3'
  name: stackgres-operator
  namespace: stackgres-system
spec:
  replicas: 1
  selector:
    matchLabels:
      app: stackgres-operator
      group: stackgres.io
  template:
    metadata:
      labels:
        app: stackgres-operator
        group: stackgres.io
    spec:
      containers:
      - env:
        - name: OPERATOR_NAME
          value: stackgres-operator
        - name: OPERATOR_NAMESPACE
          valueFrom:
            fieldRef:
              apiVersion: v1
              fieldPath: metadata.namespace
        - name: OPERATOR_SERVICE_ACCOUNT
          valueFrom:
            fieldRef:
              apiVersion: v1
              fieldPath: spec.serviceAccountName
        - name: OPERATOR_POD_NAME
          valueFrom:
            fieldRef:
              apiVersion: v1
              fieldPath: metadata.name
        - name: OPERATOR_IP
          valueFrom:
            fieldRef:
              apiVersion: v1
              fieldPath: status.podIP
        - name: OPERATOR_IMAGE_VERSION
          value: '1.16.3'
        - name: OPERATOR_NATIVE_IMAGE_VERSION
          value: '1.16.3'
        - name: OPERATOR_JVM_IMAGE_VERSION
          value: '1.16.3-jvm'
        - name: SG_CONTAINER_REGISTRY
          value: quay.io
        - name: SG_IMAGE_PULL_POLICY
          value: IfNotPresent
        - name: INSTALL_CRDS
          value: 'true'
        - name: INSTALL_WEBHOOKS
          value: 'true'
        - name: INSTALL_CONVERSION_WEBHOOKS
          value: 'true'
        - name: INSTALL_CERTS
          value: 'true'
        - name: INSTALL_CONFIG
          value: 'true'
        - name: CLUSTER_ROLE_DISABLED
          value: 'false'
        - name: DISABLE_RECONCILIATION
          value: 'false'
        - name: WAIT_CRDS_UPGRADE
          value: 'false'
        - name: EXTENSIONS_REPOSITORY_URLS
          value: https://extensions.stackgres.io/postgres/repository
        - name: PROMETHEUS_AUTOBIND
          value: 'true'
        - name: GRAFANA_EMBEDDED
          value: 'false'
        - name: SGCONFIG_NAMESPACE
          value: stackgres-system
        image: quay.io/stackgres/operator:1.16.3
        imagePullPolicy: IfNotPresent
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /q/health/live
            port: 8080
            scheme: HTTP
          initialDelaySeconds: 10
          periodSeconds: 60
          timeoutSeconds: 10
        name: stackgres-operator
        ports:
        - containerPort: 8080
          name: http
          protocol: TCP
        - containerPort: 8443
          name: https
          protocol: TCP
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /q/health/ready
            port: 8080
            scheme: HTTP
          periodSeconds: 2
          timeoutSeconds: 1
        resources:
          limits:
            cpu: '2'
            memory: '4Gi'
          requests:
            cpu: '100m'
            memory: '512Mi'
        volumeMounts:
        - mountPath: /etc/operator/certs
          name: operator-certs
          readOnly: true
      securityContext:
        fsGroup: 1000
        runAsGroup: 1000
        runAsNonRoot: true
        runAsUser: 1000
      serviceAccountName: stackgres-operator
      volumes:
      - name: operator-certs
        secret:
          defaultMode: 420
          optional: true
          secretName: stackgres-operator-certs
---
