{
  "$defs": {
    "ApplyAction": {
      "description": "Action taken during apply, serialized in `snake_case` in the deploy log.",
      "oneOf": [
        {
          "const": "created",
          "description": "Resource was created.",
          "type": "string"
        },
        {
          "const": "configured",
          "description": "Resource was updated because its identity-hash changed.",
          "type": "string"
        },
        {
          "const": "unchanged",
          "description": "Resource was skipped because its identity-hash matched.",
          "type": "string"
        },
        {
          "const": "skipped",
          "description": "Resource was skipped for another reason.",
          "type": "string"
        }
      ]
    },
    "Because": {
      "description": "Why a node was cancelled.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "This node waited on the one that failed.",
          "properties": {
            "predecessor_failed": {
              "$ref": "#/$defs/ResourceId"
            }
          },
          "required": [
            "predecessor_failed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The run was cancelled. Always `true`.",
          "properties": {
            "external": {
              "const": true,
              "type": "boolean"
            }
          },
          "required": [
            "external"
          ],
          "type": "object"
        }
      ]
    },
    "Busy": {
      "description": "A node in flight when the run stalled.",
      "properties": {
        "node": {
          "description": "The node, as the text log names it.",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "since_ms": {
          "description": "How long it has been in this phase.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "node",
        "phase",
        "since_ms"
      ],
      "type": "object"
    },
    "ControllerFound": {
      "description": "What Kix found when it read a controller.",
      "oneOf": [
        {
          "const": "ready",
          "description": "Ready, with at least one ready pod.",
          "type": "string"
        },
        {
          "const": "not_ready",
          "description": "On the cluster and not ready, or scaled to no ready pod.",
          "type": "string"
        },
        {
          "const": "missing",
          "description": "Not on the cluster.",
          "type": "string"
        },
        {
          "const": "unread",
          "description": "Kix could not read it.",
          "type": "string"
        }
      ]
    },
    "DeletionController": {
      "description": "A controller of an object whose delete did not finish.",
      "properties": {
        "detail": {
          "description": "Why it is not ready, or why Kix could not read it.",
          "type": [
            "string",
            "null"
          ]
        },
        "resource": {
          "$ref": "#/$defs/ResourceId"
        },
        "state": {
          "$ref": "#/$defs/ControllerFound"
        }
      },
      "required": [
        "resource",
        "state"
      ],
      "type": "object"
    },
    "Detail": {
      "description": "What a node's state change carries, named by its one key.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "applied": {
              "$ref": "#/$defs/ApplyAction"
            }
          },
          "required": [
            "applied"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "apply_failed": {
              "type": "string"
            }
          },
          "required": [
            "apply_failed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "readiness_timeout": {
              "properties": {
                "elapsed_ms": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "elapsed_ms",
                "message"
              ],
              "type": "object"
            }
          },
          "required": [
            "readiness_timeout"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "readiness_failed": {
              "properties": {
                "message": {
                  "type": "string"
                },
                "missing_keys": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "output": {
                  "description": "The last lines a failed container wrote.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "message",
                "missing_keys",
                "output"
              ],
              "type": "object"
            }
          },
          "required": [
            "readiness_failed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "How many keys were decrypted into the Secret.",
          "properties": {
            "secret_hydrated": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "secret_hydrated"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "secret_hydration_failed": {
              "type": "string"
            }
          },
          "required": [
            "secret_hydration_failed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "recreated_in_place": {
              "type": "string"
            }
          },
          "required": [
            "recreated_in_place"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "rerun": {
              "type": "string"
            }
          },
          "required": [
            "rerun"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An `OnDelete` DaemonSet is ready, and `stale` of its pods run the\nprevious template until someone deletes them. `message` says why.",
          "properties": {
            "pending_restart": {
              "properties": {
                "message": {
                  "type": "string"
                },
                "stale": {
                  "format": "int64",
                  "type": "integer"
                }
              },
              "required": [
                "stale",
                "message"
              ],
              "type": "object"
            }
          },
          "required": [
            "pending_restart"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A custom resource is ready, and its controller reports the state its\npackage declared as `pendingRestart`: the running workload keeps the\nprevious spec until someone restarts it. `message` says why.",
          "properties": {
            "awaiting_restart": {
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ],
              "type": "object"
            }
          },
          "required": [
            "awaiting_restart"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A prune found nothing to delete, and the text says why, such as\n`already gone (Kubernetes does not recognize its kind)`.",
          "properties": {
            "already_gone": {
              "type": "string"
            }
          },
          "required": [
            "already_gone"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A delete did not finish within the wait: after `elapsed_ms`, the\nobject was still on the cluster, held by `finalizers`. `controllers`\nlists the workloads its kind names as its controller (`controller` on\n`scope.mkCRD`), with what Kix found when it read them. `message` is\nthe text the failure reports.",
          "properties": {
            "deletion_unfinished": {
              "properties": {
                "controllers": {
                  "items": {
                    "$ref": "#/$defs/DeletionController"
                  },
                  "type": "array"
                },
                "elapsed_ms": {
                  "format": "uint64",
                  "minimum": 0,
                  "type": "integer"
                },
                "finalizers": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "elapsed_ms",
                "finalizers",
                "controllers",
                "message"
              ],
              "type": "object"
            }
          },
          "required": [
            "deletion_unfinished"
          ],
          "type": "object"
        }
      ]
    },
    "Edge": {
      "description": "`dependent` waits on `predecessor`.",
      "properties": {
        "dependent": {
          "$ref": "#/$defs/NodeRef"
        },
        "predecessor": {
          "$ref": "#/$defs/NodeRef"
        }
      },
      "required": [
        "dependent",
        "predecessor"
      ],
      "type": "object"
    },
    "FieldNotKept": {
      "description": "A field Kix applied that Kubernetes did not store as sent.",
      "properties": {
        "change": {
          "$ref": "#/$defs/NotKept"
        },
        "path": {
          "type": "string"
        },
        "sent": {
          "description": "The value Kix sent. A Secret value reads `(secret, not shown)`."
        },
        "stored": {
          "description": "The value Kubernetes stored. Absent when it dropped the field."
        }
      },
      "required": [
        "path",
        "change",
        "sent"
      ],
      "type": "object"
    },
    "Import": {
      "description": "The resource an import marker waits for.",
      "properties": {
        "apiVersion": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "name",
        "apiVersion"
      ],
      "type": "object"
    },
    "LeftBehind": {
      "description": "The objects of a kind that stay on the cluster after the definition of\nthe kind leaves the build. Kix did not create them, or keeps them for\nanother reason, so the prune does not delete them. Once the package\nthat handled the kind is gone, nothing removes their finalizers or\ncleans up what they made outside the cluster.",
      "properties": {
        "count": {
          "description": "How many objects of the kind stay.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "description": "The kind, as `Kind.group`.",
          "type": "string"
        },
        "objects": {
          "description": "The first [`LEFT_BEHIND_LISTED`] of them, objects with finalizers\nfirst.",
          "items": {
            "$ref": "#/$defs/LeftObject"
          },
          "type": "array"
        },
        "with_finalizers": {
          "default": 0,
          "description": "How many of them have finalizers.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "count",
        "objects"
      ],
      "type": "object"
    },
    "LeftObject": {
      "properties": {
        "finalizers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resource": {
          "type": "string"
        }
      },
      "required": [
        "resource"
      ],
      "type": "object"
    },
    "NodeRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceId"
        },
        {
          "properties": {
            "synthetic": {
              "type": "string"
            }
          },
          "required": [
            "synthetic"
          ],
          "type": "object"
        }
      ],
      "description": "A node: a resource, or a step that is not one (`synthetic`)."
    },
    "NotKept": {
      "description": "What Kubernetes did with a field Kix applied.",
      "oneOf": [
        {
          "const": "dropped",
          "description": "The stored object does not have the field.",
          "type": "string"
        },
        {
          "const": "changed",
          "description": "The stored object has another value.",
          "type": "string"
        }
      ]
    },
    "Phase": {
      "description": "What a node in flight is doing. Reported by the watchdog.",
      "oneOf": [
        {
          "const": "hydrate",
          "description": "Decrypting SOPS secrets before apply.",
          "type": "string"
        },
        {
          "const": "apply",
          "description": "Server-side apply request outstanding (including transport retries).",
          "type": "string"
        },
        {
          "const": "readiness",
          "description": "Polling the object for readiness.",
          "type": "string"
        },
        {
          "const": "discovery",
          "description": "API discovery refresh behind a CRD barrier.",
          "type": "string"
        },
        {
          "const": "deletion",
          "description": "Waiting for a deleted object to be gone.",
          "type": "string"
        }
      ]
    },
    "PlannedNode": {
      "description": "A node of the plan.",
      "properties": {
        "id": {
          "$ref": "#/$defs/NodeRef"
        },
        "import": {
          "anyOf": [
            {
              "$ref": "#/$defs/Import"
            },
            {
              "type": "null"
            }
          ],
          "description": "For an import marker, the resource it waits for."
        },
        "kind": {
          "$ref": "#/$defs/TransitionKind"
        },
        "namespace": {
          "type": [
            "string",
            "null"
          ]
        },
        "package": {
          "description": "The Kix package instance the node belongs to.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "type": "object"
    },
    "ResourceId": {
      "description": "Unique identifier for a K8s resource.\n\nThe API group is part of the identity, because two groups can serve a\nkind of one name (`Job` in `batch` and in `batch.volcano.sh`).",
      "properties": {
        "group": {
          "description": "The API group, `\"\"` for the core group. JSON leaves out the core\ngroup, so JSON written before the id carried a group reads as it.",
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "namespace",
        "name"
      ],
      "type": "object"
    },
    "State": {
      "description": "A node's verdict, named by `state`.",
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "pending",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "running",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "state": {
              "const": "ready",
              "type": "string"
            }
          },
          "required": [
            "state"
          ],
          "type": "object"
        },
        {
          "properties": {
            "message": {
              "type": "string"
            },
            "state": {
              "const": "failed",
              "type": "string"
            }
          },
          "required": [
            "state",
            "message"
          ],
          "type": "object"
        },
        {
          "properties": {
            "because": {
              "$ref": "#/$defs/Because"
            },
            "state": {
              "const": "cancelled",
              "type": "string"
            }
          },
          "required": [
            "state",
            "because"
          ],
          "type": "object"
        },
        {
          "properties": {
            "prompt": {
              "type": "string"
            },
            "state": {
              "const": "awaiting_input",
              "type": "string"
            }
          },
          "required": [
            "state",
            "prompt"
          ],
          "type": "object"
        },
        {
          "description": "Was ready, and readiness now says otherwise.",
          "properties": {
            "message": {
              "type": "string"
            },
            "since_ms": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "state": {
              "const": "drift",
              "type": "string"
            }
          },
          "required": [
            "state",
            "since_ms",
            "message"
          ],
          "type": "object"
        }
      ]
    },
    "TransitionKind": {
      "description": "What kind of operation a node represents.\n\nThe planner tags every node in the plan with one of these. Rendering and\nscheduling both branch on this tag. The deploy log names it in\nsnake_case.",
      "oneOf": [
        {
          "const": "apply",
          "description": "Server-side apply a manifest.",
          "type": "string"
        },
        {
          "const": "skip",
          "description": "Identity-hash unchanged, so no work is needed. Rendered dim and folded\naggressively.",
          "type": "string"
        },
        {
          "const": "recreate",
          "description": "Delete the live object, then apply. Tagged `recreate` because that\nis the act, whatever the trigger. The current producer is the\nrerun rule: a Job carrying the rerun annotation whose rerun hash\nchanged is run again, never patched, and the reason\nrides [`NodeDetail::Rerun`]. The executor applies plainly when\nnothing is live.",
          "type": "string"
        },
        {
          "const": "migrate",
          "description": "Stateful migration pair barrier. Detection currently happens before\nscheduling.",
          "type": "string"
        },
        {
          "const": "drain",
          "description": "Drain consumers before deleting their provider.",
          "type": "string"
        },
        {
          "const": "delete",
          "description": "Delete an orphaned resource.",
          "type": "string"
        },
        {
          "const": "pause",
          "description": "Wait for operator approval.",
          "type": "string"
        },
        {
          "const": "wait",
          "description": "Wait for an object the build needs and another Kix cluster writes,\nsuch as Kix's own CRDs on a consumer cluster.\nNothing is applied or stamped.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One line of the log.\n\nLater versions of Kix may add fields and new types of line. Skip the ones\nyou do not know.",
  "oneOf": [
    {
      "description": "The Kubernetes cluster the deploy writes to. The first line of the\nlog. A deploy whose build is empty never connects, so its log has\nonly the `summary` line.",
      "properties": {
        "context": {
          "description": "The kubeconfig context, or `null` when the kubeconfig names none.",
          "type": [
            "string",
            "null"
          ]
        },
        "server": {
          "description": "The URL of the context's API server in the kubeconfig, or `null`\nwhen the kubeconfig does not give it.",
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "const": "kubernetes",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "description": "The plan, before any node runs. `edges` say which node waits on which.",
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/PlannedNode"
          },
          "type": "array"
        },
        "type": {
          "const": "plan",
          "type": "string"
        }
      },
      "required": [
        "type",
        "nodes",
        "edges"
      ],
      "type": "object"
    },
    {
      "description": "A node's verdict advanced.",
      "properties": {
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/Detail"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/NodeRef"
        },
        "kind": {
          "$ref": "#/$defs/TransitionKind"
        },
        "type": {
          "const": "node",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/State"
        }
      },
      "required": [
        "type",
        "id",
        "kind",
        "verdict"
      ],
      "type": "object"
    },
    {
      "description": "CRDs were applied, so API discovery ran again.",
      "properties": {
        "type": {
          "const": "crd_rediscovery",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    {
      "description": "Start of orphan pruning. `resources` lists orphans in prune order,\n`count` is `resources.len()`, `delete` indicates whether this run\ndeletes or only reports them, and `kept` lists orphans retained by\nprune policy.",
      "properties": {
        "count": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "delete": {
          "type": "boolean"
        },
        "kept": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resources": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "const": "prune_start",
          "type": "string"
        }
      },
      "required": [
        "type",
        "count",
        "delete",
        "resources",
        "kept"
      ],
      "type": "object"
    },
    {
      "description": "The prune left `resource` in place when it came to delete it.",
      "properties": {
        "reason": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "type": {
          "const": "prune_kept",
          "type": "string"
        }
      },
      "required": [
        "type",
        "resource",
        "reason"
      ],
      "type": "object"
    },
    {
      "description": "The new Activation record is current, and `previous` is superseded.",
      "properties": {
        "activation": {
          "type": "string"
        },
        "previous": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "const": "finalized",
          "type": "string"
        }
      },
      "required": [
        "type",
        "activation"
      ],
      "type": "object"
    },
    {
      "description": "The run stopped due to cancellation or a failure.",
      "properties": {
        "reason": {
          "type": "string"
        },
        "type": {
          "const": "stopped",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "type": "object"
    },
    {
      "description": "Nothing has happened for `idle_ms`. `aborting` is true on the last\none, when the run gives up.",
      "properties": {
        "aborting": {
          "type": "boolean"
        },
        "idle_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "in_flight": {
          "items": {
            "$ref": "#/$defs/Busy"
          },
          "type": "array"
        },
        "type": {
          "const": "stalled",
          "type": "string"
        }
      },
      "required": [
        "type",
        "idle_ms",
        "aborting",
        "in_flight"
      ],
      "type": "object"
    },
    {
      "description": "`node` has been in `phase` for `since_ms` without a verdict. Repeated\non a schedule while the wait lasts. `status` is the node's last\nreadiness message and `budget_ms` the readiness timeout. `holds`\nnames the resources that wait on `node` directly, as the text log\nnames them, and `holds_total` counts every resource that waits on it\ndirectly or through other nodes.",
      "properties": {
        "budget_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "holds": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "holds_total": {
          "default": 0,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "node": {
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/Phase"
        },
        "since_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "const": "waiting",
          "type": "string"
        }
      },
      "required": [
        "type",
        "node",
        "phase",
        "since_ms"
      ],
      "type": "object"
    },
    {
      "description": "A write that the next deploy redoes failed.",
      "properties": {
        "message": {
          "type": "string"
        },
        "type": {
          "const": "best_effort_failed",
          "type": "string"
        },
        "what": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "what",
        "message"
      ],
      "type": "object"
    },
    {
      "description": "The apply of `resource` succeeded, but Kubernetes did not store\n`fields` as Kix sent them. A warning: the deploy goes on.",
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldNotKept"
          },
          "type": "array"
        },
        "resource": {
          "type": "string"
        },
        "type": {
          "const": "fields_not_kept",
          "type": "string"
        }
      },
      "required": [
        "type",
        "resource",
        "fields"
      ],
      "type": "object"
    },
    {
      "description": "The counts the text summary line shows. The last line of the log.",
      "properties": {
        "cancelled": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "configured": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "created": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "dry_run": {
          "type": "boolean"
        },
        "failed": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "failed_after_apply": {
          "default": 0,
          "description": "The objects in `failed` that the run wrote to the cluster and\nthat then did not become ready. Older logs leave it out.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "kept": {
          "default": 0,
          "description": "Orphans of this Kix cluster the prune left on the cluster, held\nback by an object whose delete failed or by a dependency cycle.\nThe `prune_kept` lines name them.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "left_behind": {
          "description": "For each kind whose definition left the build, the objects of it\nthat are still on the cluster after the prune. Kix did not create\nthem, and nothing clears their finalizers once their controller\nis gone. Left out when there are none.",
          "items": {
            "$ref": "#/$defs/LeftBehind"
          },
          "type": "array"
        },
        "nothing_to_apply": {
          "default": false,
          "description": "True when the plan had nothing to apply or prune, so the deploy\nwrote nothing and the active deployment record stays current. The\nlog then holds no `plan` or `node` lines.",
          "type": "boolean"
        },
        "pruned": {
          "description": "Orphans this run deleted. An orphan already gone is not counted.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "succeeded": {
          "type": "boolean"
        },
        "type": {
          "const": "summary",
          "type": "string"
        },
        "unchanged": {
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "dry_run",
        "succeeded",
        "created",
        "configured",
        "unchanged",
        "failed",
        "cancelled",
        "pruned"
      ],
      "type": "object"
    }
  ],
  "properties": {
    "elapsed_ms": {
      "description": "Milliseconds since the deploy started.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "description": "Schema version (`YYYY-MM-DD`), included on every line so lines can be\nparsed independently.",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "elapsed_ms"
  ],
  "title": "Line",
  "type": "object"
}
