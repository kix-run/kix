      "text": "{\"apiVersion\":\"v1\",\"kind\":\"Service\",\"metadata\":{\"annotations\":{\"kix.run/depends-on\":\"6mhckm4cnkj1gjz83k4aywdhn46rfq78,hchrgs6m060pxd03p9v6c8aqpn1fwy69\"},\"labels\":{\"app.kubernetes.io/instance\":\"landing\",\"app.kubernetes.io/managed-by\":\"kix\",\"app.kubernetes.io/part-of\":\"kix-enterprise-test\",\"cluster\":\"stage1-test\",\"team\":\"platform\"},\"name\":\"landing\",\"namespace\":\"kix-enterprise-test-edge\"},\"spec\":{\"ports\":[{\"name\":\"http\",\"port\":80,\"protocol\":\"TCP\",\"targetPort\":8080}],\"selector\":{\"app.kubernetes.io/instance\":\"landing\",\"app.kubernetes.io/name\":\"landing\"},\"type\":\"ClusterIP\"}}"
