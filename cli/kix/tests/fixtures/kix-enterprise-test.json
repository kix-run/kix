    "/nix/store/s00kgn3b4qh31g9ni5grba6d8bcfbg6k-k8s-ConfigMap-kix-enterprise-test-data-cache-config": {
      "references": [
        "/nix/store/dwdw7chkc2jav4bn45pls2cg32s4qz0a-k8s-Namespace-_cluster_-kix-enterprise-test-data"
      ],
      "text": "{\"apiVersion\":\"v1\",\"data\":{\"lib.sh\":\"# Shared by the start and preStop scripts. Every value comes from the\\n# container's environment, which the package sets:\\n#   VALKEY_PORT, SENTINEL_PORT   ports of valkey-server and Sentinel\\n#   HEADLESS_FQDN                the headless Service (Sentinel only)\\n#   VALKEY_REPLICAS              StatefulSet replicas (Sentinel only)\\n#   PRIMARY_SET                  the name Sentinel monitors (Sentinel only)\\n#   POD_NAME                     this pod's name, <statefulset>-<ordinal>\\n\\n# Pod ordinal and the stable DNS name of pod N. The headless Service\\n# publishes unready addresses, so a peer resolves before it is Ready.\\nordinal=${POD_NAME##*-}\\npeer() {\\n    echo \\\"${POD_NAME%-*}-$1.$HEADLESS_FQDN\\\"\\n}\\nSELF=${HEADLESS_FQDN:+$(peer \\\"$ordinal\\\")}\\n\\n# A config-file string holding $1 byte for byte: double quotes around a\\n# \\\\xHH escape per byte, which valkey.conf and sentinel.conf decode. Line\\n# breaks, quotes, and a trailing newline from a Secret written with echo\\n# stay part of the value, as they do for clients reading the same Secret.\\n# Write it with printf: dash's echo expands backslash escapes.\\nconf_quote() {\\n    printf '\\\"%s\\\"' \\\"$(printf '%s' \\\"$1\\\" | od -An -v -tx1 | tr -d ' \\\\n' | sed 's/../\\\\\\\\x&/g')\\\"\\n}\\n\\n# Prints \\\"host port\\\" of the primary as the first Sentinel of another pod\\n# reports it, or fails when none answers. Sentinel's default user takes no\\n# password, and an AUTH with one is an error, so the password variable is\\n# dropped for these calls.\\nask_sentinels() {\\n    i=0\\n    while [ \\\"$i\\\" -lt \\\"$VALKEY_REPLICAS\\\" ]; do\\n        if [ \\\"$i\\\" != \\\"$ordinal\\\" ]; then\\n            answer=$(env -u REDISCLI_AUTH timeout 5 valkey-cli -h \\\"$(peer \\\"$i\\\")\\\" -p \\\"$SENTINEL_PORT\\\" \\\\\\n                SENTINEL get-primary-addr-by-name \\\"$PRIMARY_SET\\\" 2>/dev/null | tr '\\\\n' ' ')\\n            # shellcheck disable=SC2086 # split the reply into host and port\\n            set -- $answer\\n            if [ \\\"$#\\\" -eq 2 ]; then\\n                echo \\\"$1 $2\\\"\\n                return 0\\n            fi\\n        fi\\n        i=$((i + 1))\\n    done\\n    return 1\\n}\\n\\n# Prints \\\"host port\\\" of the primary. When no other Sentinel answers within\\n# three tries, this is a first start or a restart after every pod stopped,\\n# and pod 0 is the primary.\\nfind_primary() {\\n    for _ in 1 2 3; do\\n        if ask_sentinels; then\\n            return 0\\n        fi\\n        sleep 2\\n    done\\n    echo \\\"$(peer 0) $VALKEY_PORT\\\"\\n}\\n\\n# The primary the local Sentinel reports, host only.\\nlocal_sentinel_primary() {\\n    env -u REDISCLI_AUTH timeout 3 valkey-cli -p \\\"$SENTINEL_PORT\\\" \\\\\\n        SENTINEL get-primary-addr-by-name \\\"$PRIMARY_SET\\\" 2>/dev/null | head -n 1\\n}\\n\\n# Waits until the local Sentinel reports a primary other than this pod.\\n# Gives up once the clock passes $1 (seconds since the epoch); the last\\n# check can end up to 4s later.\\nwait_primary_moved() {\\n    while [ \\\"$(date +%s)\\\" -lt \\\"$1\\\" ]; do\\n        current=$(local_sentinel_primary)\\n        if [ -n \\\"$current\\\" ] && [ \\\"$current\\\" != \\\"$SELF\\\" ]; then\\n            return 0\\n        fi\\n        sleep 1\\n    done\\n    return 1\\n}\\n\",\"probe.sh\":\"#!/bin/sh\\n# Container probes. $1 is the mode:\\n#   liveness   valkey-server answers PONG, or is loading its dataset\\n#              (LOADING) or is a replica without a primary (MASTERDOWN)\\n#   readiness  valkey-server answers PONG\\n#   sentinel   Sentinel answers PONG\\nset -u\\n\\ncase \\\"$1\\\" in\\nsentinel)\\n    reply=$(env -u REDISCLI_AUTH timeout 3 valkey-cli -p \\\"$SENTINEL_PORT\\\" ping 2>&1)\\n    ;;\\n*)\\n    reply=$(timeout 3 valkey-cli -p \\\"$VALKEY_PORT\\\" ping 2>&1)\\n    ;;\\nesac\\n\\ncase \\\"$1:$reply\\\" in\\n*:PONG) exit 0 ;;\\nliveness:*LOADING* | liveness:*MASTERDOWN*) exit 0 ;;\\nesac\\necho \\\"$reply\\\"\\nexit 1\\n\",\"start-valkey.sh\":\"#!/bin/sh\\n# Writes the runtime valkey.conf and starts valkey-server on it. The\\n# password goes into the file, not argv, because /proc/<pid>/cmdline is\\n# readable by every process in the container. REDISCLI_AUTH holds it.\\nset -eu\\n. /opt/valkey/lib.sh\\n\\nif [ -z \\\"$REDISCLI_AUTH\\\" ]; then\\n    echo \\\"valkey: key password of the valkeyPassword secret is empty, and requirepass \\\\\\\"\\\\\\\" would turn authentication off; set a password\\\" >&2\\n    exit 1\\nfi\\npassword=$(conf_quote \\\"$REDISCLI_AUTH\\\")\\nconf=/run/valkey/valkey.conf\\numask 077\\n{\\n    echo \\\"include /opt/valkey/valkey.conf\\\"\\n    echo \\\"port $VALKEY_PORT\\\"\\n    echo \\\"dir /data\\\"\\n    printf 'requirepass %s\\\\nprimaryauth %s\\\\n' \\\"$password\\\" \\\"$password\\\"\\n    if [ \\\"$SENTINEL_ENABLED\\\" = yes ]; then\\n        echo \\\"replica-announce-ip $SELF\\\"\\n        echo \\\"replica-announce-port $VALKEY_PORT\\\"\\n        # shellcheck disable=SC2046 # split \\\"host port\\\"\\n        set -- $(find_primary)\\n        if [ \\\"$1\\\" = \\\"$SELF\\\" ]; then\\n            echo \\\"valkey: starting as the primary\\\" >&2\\n        else\\n            echo \\\"valkey: starting as a replica of $1:$2\\\" >&2\\n            echo \\\"replicaof $1 $2\\\"\\n        fi\\n    fi\\n} >\\\"$conf.tmp\\\"\\nmv \\\"$conf.tmp\\\" \\\"$conf\\\"\\nexec valkey-server \\\"$conf\\\"\\n\",\"valkey.conf\":\"appendonly yes\\nmaxmemory 128mb\\nmaxmemory-policy allkeys-lru\\n\"},\"kind\":\"ConfigMap\",\"metadata\":{\"annotations\":{\"kix.run/depends-on\":\"dwdw7chkc2jav4bn45pls2cg32s4qz0a\"},\"labels\":{\"app.kubernetes.io/instance\":\"cache\",\"app.kubernetes.io/managed-by\":\"kix\",\"app.kubernetes.io/part-of\":\"kix-enterprise-test\",\"cluster\":\"stage1-test\",\"team\":\"platform\"},\"name\":\"cache-config\",\"namespace\":\"kix-enterprise-test-data\"}}"
    },
