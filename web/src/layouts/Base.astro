---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Kix | The Kubernetes compiler',
  description = 'Kix is a Kubernetes compiler. Compile your whole cluster from one definition, check it, preview the change, and deploy from your laptop or CI.',
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={url} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2efe7" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kix" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-ink px-4 py-2 text-paper focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Skip to content</a
    >
    <slot />
    <p id="copy-status" class="sr-only" aria-live="polite"></p>
    <script>
      // Copy buttons (components/CopyButton.astro).
      const status = document.getElementById('copy-status');
      document.addEventListener('click', async (event) => {
        const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-copy]');
        if (!button) return;
        try {
          await navigator.clipboard.writeText(button.dataset.copy ?? '');
        } catch {
          if (status) status.textContent = 'Copy failed. Select the command and copy it instead.';
          return;
        }
        if (status) status.textContent = 'Copied to the clipboard.';
        button.classList.add('is-copied');
        window.setTimeout(() => button.classList.remove('is-copied'), 1600);
      });
    </script>
    <style is:global>
      .copy-button.is-copied .copy-icon {
        display: none;
      }
      .copy-button.is-copied .check-icon {
        display: block;
        color: var(--t-green);
      }
    </style>
  </body>
</html>
