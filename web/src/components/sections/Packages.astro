---
import Section from '../Section.astro';
import Heading from '../Heading.astro';

const escapeHatches = [
  {
    title: 'Import external managed services',
    desc: 'Wire an external AWS RDS or CloudSQL database into your cluster definition so consuming apps receive its endpoint and credentials without changing app code.',
    code: `db = kix.mkImport {
  out.fqdn = "rds.prod.internal";
  # ... credentials
};`,
  },
  {
    title: 'Reference Secrets managed outside Kix',
    desc: 'Wrap an externally provisioned Secret name in kix.untrackedRef so kix check knows it is intentionally provided outside the build and tracks it in audit output.',
    code: 'secretName = kix.untrackedRef "rds-creds";',
  },
  {
    title: 'Override any raw Kubernetes field',
    desc: 'Every Kix package exposes the underlying Kubernetes resources and PodSpec fields, so you can set priorityClassName, nodeSelector, tolerations, or custom sidecars directly.',
    code: 'spec.template.spec.priorityClassName = "production-high";',
  },
  {
    title: 'Bring existing Helm charts',
    desc: 'Include existing Helm charts alongside native Kix packages so you can adopt Kix incrementally with the third-party software you already run.',
    code: `chart = kix.helmChart {
  repo = "https://charts.jetstack.io";
  name = "cert-manager";
  # ... version, hash
};`,
  },
];
---

<Section id="packages" tone="paper-2" labelledby="packages-title">
  <div class="flex flex-col gap-14">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[520px_minmax(0,1fr)] lg:gap-20">
      <div class="flex flex-col gap-5">
        <Heading id="packages-title" size="lg">Packages &amp; escape hatches</Heading>
        <p class="text-[17px] leading-[1.55] text-ink-2 md:text-[18px]">
          The library covers databases, caches, observability, networking, and applications, with new packages tested
          against real clusters and added continuously.
        </p>
      </div>
      <div class="flex flex-col gap-6">
        {
          escapeHatches.map((item) => (
            <div class="flex flex-col gap-3 rounded-xl border border-line bg-paper p-6">
              <h3 class="text-[20px] font-semibold text-ink">{item.title}</h3>
              <p class="text-[15.5px] leading-[1.55] text-ink-2">{item.desc}</p>
              <pre class="overflow-x-auto rounded-md border border-night-line bg-night px-4 py-3 font-mono text-[13px] leading-[1.6] text-t-blue"><code>{item.code}</code></pre>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Section>
