---
import Section from '../Section.astro';
import Heading from '../Heading.astro';

// The YAML layer diagram is drawn on a 560 × 430 canvas. Positions,
// sizes, and the font size are percentages of that canvas (cqw for text),
// so the picture scales down on narrow screens without reflowing.
const slabs = [
  { num: '5', text: 'policy engines that check YAML afterwards', x: 64, y: 24, rotate: -2.2 },
  { num: '4', text: 'controllers that sync YAML from git', x: 40, y: 94, rotate: 1.6 },
  { num: '3', text: 'overlays that patch YAML', x: 78, y: 164, rotate: -1.2 },
  { num: '2', text: 'templates that generate YAML', x: 30, y: 234, rotate: 0.9 },
  { num: '1', text: 'YAML', x: 56, y: 304, rotate: 0, base: true },
];
const W = 560;
const H = 430;
const pct = (n: number, of: number) => `${((n / of) * 100).toFixed(3)}%`;

const beats = [
  {
    title: 'See the whole cluster',
    body: 'Generating YAML in another language still leaves you with separate files. Checking selectors, ports, and rollout order takes a compiler that sees everything together.',
  },
  {
    title: 'Fast feedback for agents',
    body: 'Application code gives coding agents instant compiler errors. Infrastructure needed that same local check before a broken change ever reaches a cluster.',
  },
  {
    title: 'Never repeat an outage',
    body: 'Whenever we hit a subtle Kubernetes trap in production, we build that check into Kix once so neither an engineer nor an agent can repeat it.',
  },
];
---

<Section id="why" rule labelledby="why-title">
  <div class="flex flex-col gap-14 lg:gap-[72px]">
    <div class="grid grid-cols-1 items-center gap-12 xl:grid-cols-[minmax(0,1fr)_minmax(0,560px)] xl:gap-20">
      <div class="flex flex-col gap-5">
        <Heading id="why-title">Five layers of YAML was enough</Heading>
        <p class="text-[17px] leading-[1.55] text-ink-2 md:text-[18.5px]">
          Kix started over a beer in Munich. One of us runs custom bare-metal Kubernetes clusters 24/7 at <a
            href="https://lithus.eu"
            class="text-accent-text hover:underline">Lithus</a
          >, where every client's setup is different and a bad deploy wakes someone up at night. The other came to
          Kubernetes fresh while building with coding agents, baffled that the normal way to find a config mistake is to
          deploy it and see what breaks.
        </p>
        <p class="text-[17px] leading-[1.55] text-ink-2 md:text-[18.5px]">
          Templates, overlays, sync controllers, and policy scanners each solved a real need, yet together they made
          clusters harder to reason about. So we went back to first principles and built a compiler for the whole
          cluster.
        </p>
      </div>
      <div class="@container mx-auto flex w-full max-w-[560px] flex-col">
        <ol
          aria-label="Layers of tooling on top of Kubernetes, newest first"
          class="relative w-full"
          style={`aspect-ratio: ${W} / ${H}`}
        >
          {
            slabs.map((s) => (
              <li
                class:list={[
                  'absolute flex items-center gap-[2.15cqw] rounded-md border-[1.5px] border-ink px-[3.2cqw] font-mono',
                  s.base ? 'bg-paper-2' : 'bg-paper',
                ]}
                style={`left:${pct(s.x, W)};top:${pct(s.y, H)};width:${pct(440, W)};height:${pct(56, H)};transform:rotate(${s.rotate}deg)`}
              >
                <span class="text-[2.15cqw] text-ink-2">{s.num}</span>
                <span class="truncate text-[2.5cqw] text-ink">{s.text}</span>
              </li>
            ))
          }
          <li
            class="absolute flex items-center rounded-md bg-ink px-[3.6cqw] font-mono text-[2.7cqw] font-semibold text-paper"
            style={`left:0;top:${pct(372, H)};width:100%;height:${pct(58, H)}`}
          >
            Kubernetes resources
          </li>
        </ol>
      </div>
    </div>
    <div class="grid grid-cols-1 border-t border-line md:grid-cols-3">
      {
        beats.map((b, i) => (
          <div
            class:list={[
              'flex flex-col gap-3.5 pt-8 md:pr-10',
              i > 0 && 'max-md:mt-8 max-md:border-t max-md:border-line md:border-l md:border-line md:pl-10',
            ]}
          >
            <Heading as="h3" size="md">
              {b.title}
            </Heading>
            <p class="text-base leading-[1.6] text-ink-2">{b.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</Section>
