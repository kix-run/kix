---
import Section from '../Section.astro';
import Heading from '../Heading.astro';

// Copy from addendum A1 (kix-oss-handoff/addenda/A1-nix-language-copy).
// `body` is trusted HTML so commands and file names can be inline code.
const code = (text: string) =>
  `<code class="rounded bg-paper px-1 py-0.5 font-mono text-[13px] text-ink">${text}</code>`;

const reasons = [
  {
    title: 'String context',
    body: 'Nix strings can carry hidden context paths alongside their text. Kix attaches resource identity and endpoint metadata to every output, and Nix preserves that metadata through string interpolation and ConfigMaps so Kix can trace every dependency and network edge.',
  },
  {
    title: 'Pure evaluation',
    body: `A Nix expression cannot change anything outside the evaluation. Evaluating a definition never calls the Kubernetes API, so ${code('kix check')} and ${code('kix build')} run without cluster credentials.`,
  },
  {
    title: 'Locked inputs',
    body: `${code('flake.lock')} pins Kix and every package by hash, and image digests are committed with the definition. The same commit builds the same resources.`,
  },
  {
    title: 'The module system',
    body: 'Package options have types and defaults, and settings from flavors and clusters are merged by the same rules everywhere.',
  },
];
---

<Section tone="paper-2" labelledby="language-title">
  <div class="flex flex-col gap-12 lg:gap-16">
    <div class="flex max-w-[720px] flex-col gap-5">
      <Heading id="language-title">Why the Nix language?</Heading>
      <p class="text-[17px] leading-[1.55] text-ink-2 md:text-[18px]">
        Kix definitions are written in the Nix language, which has been used for reproducible builds for over 20 years.
        Kix relies on four of the language's features directly.
      </p>
    </div>
    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {
        reasons.map((reason) => (
          <li class="flex flex-col gap-3 border-t-[1.5px] border-ink pt-5">
            <h3 class="text-[18px] leading-[1.3] font-semibold">{reason.title}</h3>
            <p class="text-[14.5px] leading-[1.55] text-ink-2" set:html={reason.body} />
          </li>
        ))
      }
    </ul>
  </div>
</Section>
