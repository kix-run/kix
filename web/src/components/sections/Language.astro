---
import Section from '../Section.astro';
import Heading from '../Heading.astro';

// Copy from addendum A1 (kix-oss-handoff/addenda/A1-nix-language-copy).
// `body` is trusted HTML so commands and file names can be inline code.
const code = (text: string) =>
  `<code class="rounded bg-paper px-1 py-0.5 font-mono text-[13px] text-ink">${text}</code>`;

const reasons = [
  {
    title: 'String context',
    body: 'Nix strings can carry hidden context paths alongside their text. Kix encodes resource identity on every output and endpoint details on network addresses. Nix preserves that context through string interpolation, and Kix carries it through ConfigMaps to order deployments and generate network policies.',
  },
  {
    title: 'Pure evaluation',
    body: `In pure evaluation, Nix expressions cannot read environment variables, undeclared files, or live network APIs. Evaluating a definition never contacts a cluster, so ${code('kix check')} and ${code('kix build')} run without cluster credentials.`,
  },
  {
    title: 'Locked inputs',
    body: `${code('flake.lock')} pins the Kix library and external inputs by hash, and image digests are committed with the definition. The same commit builds the same resources.`,
  },
  {
    title: 'The module system',
    body: 'Cluster and package options have types and defaults, and settings from cluster profiles and clusters merge by the same rules everywhere.',
  },
];
---

<Section tone="paper-2" labelledby="language-title">
  <div class="flex flex-col gap-12 lg:gap-16">
    <div class="flex max-w-[720px] flex-col gap-5">
      <Heading id="language-title">Why Nix?</Heading>
      <p class="text-[17px] leading-[1.55] text-ink-2 md:text-[18px]">
        Kix definitions are written in the Nix language, part of a build system used for reproducible software for over
        20 years. Kix relies on four capabilities from Nix and its standard library.
      </p>
    </div>
    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {
        reasons.map((reason) => (
          <li class="flex flex-col gap-3 border-t-[1.5px] border-ink pt-5">
            <h3 class="text-[18px] leading-[1.3] font-semibold">{reason.title}</h3>
            <p class="text-[14.5px] leading-[1.55] text-ink-2" set:html={reason.body} />
          </li>
        ))
      }
    </ul>
  </div>
</Section>
