---
import { Menu, X } from '@lucide/astro';
import Container from '../Container.astro';
import Logo from '../Logo.astro';
import Button from '../Button.astro';
import { NAV_LINKS } from '@/lib/nav';
import { INSTALL_URL } from '@/lib/links';
---

<header id="site-nav" class="sticky top-0 z-40 border-b border-transparent bg-paper transition-colors">
  <Container>
    <nav aria-label="Main" class="flex items-center justify-between gap-6 py-4 lg:py-6">
      <a href="/" aria-label="Kix home" class="rounded-md"><Logo /></a>
      <ul class="hidden items-center gap-9 lg:flex">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-[15px] text-ink-2 transition-colors hover:text-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="flex items-center gap-2">
        <Button href={INSTALL_URL} variant="ink" size="sm" class="hidden sm:inline-flex">Install the CLI</Button>
        <button
          type="button"
          id="nav-toggle"
          aria-expanded="false"
          aria-controls="nav-menu"
          aria-label="Open menu"
          class="inline-flex size-10 items-center justify-center rounded-lg text-ink hover:bg-paper-2 lg:hidden"
        >
          <Menu size={22} aria-hidden="true" class="menu-open" />
          <X size={22} aria-hidden="true" class="menu-close hidden" />
        </button>
      </div>
    </nav>
  </Container>
  <div id="nav-menu" hidden class="border-t border-line bg-paper lg:hidden">
    <Container>
      <ul class="flex flex-col py-2">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="block border-b border-line py-3.5 text-[17px] text-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="pt-3 pb-5 sm:hidden">
        <Button href={INSTALL_URL} variant="ink" class="w-full">Install the CLI</Button>
      </div>
    </Container>
  </div>
</header>

<script>
  const header = document.getElementById('site-nav')!;
  const toggle = document.getElementById('nav-toggle')!;
  const menu = document.getElementById('nav-menu')!;

  // The hairline appears once the page scrolls under the nav.
  const onScroll = () => header.classList.toggle('border-line', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle.querySelector('.menu-open')?.classList.toggle('hidden', open);
    toggle.querySelector('.menu-close')?.classList.toggle('hidden', !open);
  };
  toggle.addEventListener('click', () => setOpen(menu.hasAttribute('hidden')));
  menu.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !menu.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 64rem)').addEventListener('change', () => setOpen(false));
</script>
