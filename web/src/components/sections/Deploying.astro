---
import Section from '../Section.astro';
import Heading from '../Heading.astro';

// The deploy waves are a diagram of dependency order, matching the `shop` cluster rollout.
const waves = [
  ['Secret/db', 'ConfigMap/web'],
  ['Cluster/db', 'Deployment/valkey'],
  ['Service/web', 'Deployment/web'],
  ['HTTPRoute/web'],
];

const notes = [
  {
    cmd: 'kix plan',
    desc: 'Runs the deploy pipeline as a server-side dry run (dryRun=All) to surface webhook rejections, field ownership conflicts, and migrations before applying.',
  },
  {
    cmd: 'kix drift',
    desc: 'Reports Kix-managed resources whose applied fields changed on the live cluster since the last deploy, and which field manager changed them.',
  },
  {
    cmd: '--prune',
    desc: 'Removes resources no longer defined in your cluster, except Namespaces and CRDs. Without --prune, the plan lists orphans and leaves them in place.',
  },
  {
    cmd: 'kix snapshot',
    desc: 'Saves the Kix-managed resources of a live cluster to disk, so kix diff --from can compare against a point-in-time snapshot later.',
  },
];
---

<Section tone="night" labelledby="deploying-title">
  <div class="flex flex-col gap-12 lg:gap-14">
    <div class="flex max-w-[760px] flex-col gap-4">
      <Heading id="deploying-title">Roll out in dependency waves from CI or your laptop.</Heading>
      <p class="text-[17px] leading-[1.6] text-on-night-2 md:text-[18px]">
        Because the cluster definition and image pins live in Git, you can run <code class="rounded bg-night-2 px-1.5 py-0.5 font-mono text-[14.5px] text-on-night">kix deploy</code> from your laptop or any CI pipeline. Kix schedules resources wave by wave along the dependency graph and waits for each wave to report ready before applying the next.
      </p>
      <p class="text-sm text-t-dim">An optional in-cluster operator is in development.</p>
    </div>

    <div class="flex flex-col gap-4">
      <p class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1 font-mono">
        <span class="text-sm font-semibold text-t-green">$ kix deploy shop</span>
        <span class="text-[13px] text-on-night-2">scheduled along the dependency DAG</span>
      </p>
      <ol class="flex flex-col xl:flex-row xl:items-stretch">
        {
          waves.map((resources, i) => (
            <li
              class:list={[
                'flex min-w-0 flex-col xl:flex-row xl:items-center',
                i > 0 ? 'xl:flex-[1_1_96px]' : 'xl:flex-[1_1_0%]',
              ]}
            >
              {i > 0 && (
                <span
                  aria-hidden="true"
                  class="flex shrink-0 items-center gap-2 py-1.5 pl-6 xl:w-24 xl:flex-col xl:gap-1 xl:py-0 xl:pl-0"
                >
                  <span class="h-5 w-[1.5px] bg-night-line xl:hidden" />
                  <span class="font-mono text-[11px] text-t-green">ready</span>
                  <span class="hidden h-[1.5px] w-full bg-night-line xl:block" />
                </span>
              )}
              <div class="flex min-w-0 flex-1 flex-col gap-2 self-stretch rounded-lg border border-night-line bg-night-2 p-4 xl:min-h-[108px]">
                <span class="font-mono text-xs font-semibold text-t-blue">wave {i + 1}</span>
                {resources.map((r) => (
                  <span class="font-mono text-[13.5px] break-all text-on-night">{r}</span>
                ))}
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <dl class="grid grid-cols-1 border-t border-night-line pt-2 sm:grid-cols-2 lg:grid-cols-4">
      {
        notes.map((note, i) => (
          <div
            class:list={[
              'flex flex-col gap-2 py-5 lg:pb-0',
              {
                'border-t border-night-line lg:border-t-0': i > 0,
                'sm:border-t-0': i === 1,
                'sm:pr-6': i % 2 === 0,
                'sm:border-l sm:border-night-line sm:pl-6': i % 2 === 1,
                'lg:border-l lg:border-night-line lg:pl-6': i > 0,
                'lg:pr-6': i < notes.length - 1,
              },
            ]}
          >
            <dt class="font-mono text-sm font-semibold text-on-night">{note.cmd}</dt>
            <dd class="text-[14px] leading-[1.55] text-on-night-2">{note.desc}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>
