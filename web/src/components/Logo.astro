---
// The Sovereign Navy "kix" wordmark badge.
interface Props {
  tone?: 'paper' | 'night';
  size?: 'md' | 'sm';
  class?: string;
}
const { tone = 'paper', size = 'md', class: className } = Astro.props;
---

<span
  aria-hidden="true"
  class:list={[
    'kix-logo-badge inline-flex items-center justify-center rounded-[5px] border font-mono font-bold tracking-[-0.02em] text-white',
    tone === 'paper' ? 'kix-logo-paper border-night-line bg-night' : 'border-t-blue/40 bg-accent-button',
    size === 'md' ? 'px-2.5 py-1 text-[15px]' : 'px-2 py-0.5 text-[13px]',
    className,
  ]}>kix</span
>

<style>
  :global(:root[data-theme='dark']) .kix-logo-paper {
    border-color: rgba(56, 189, 248, 0.35);
    background-color: #1d65ec;
  }
</style>
