---
// Link styled as a button. "primary" is the Electric Cobalt CTA button,
// "ink" is the Sovereign Navy button, "outline" is the slate-bordered secondary,
// and "outline-night" is the secondary on a Sovereign Navy section.
// Any data-* attribute is passed to the link, as data-event is for
// Plausible (layouts/Base.astro).
interface Props {
  href: string;
  variant?: 'primary' | 'ink' | 'outline' | 'outline-night';
  size?: 'lg' | 'sm';
  class?: string;
  [data: `data-${string}`]: string;
}
const { href, variant = 'primary', size = 'lg', class: className, ...data } = Astro.props;
---

<a
  href={href}
  {...data}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-lg font-semibold whitespace-nowrap transition-colors [&_svg]:shrink-0',
    {
      'px-5 py-3 text-[14.5px]': size === 'lg',
      'px-3.5 py-2 text-[13px]': size === 'sm',
      'bg-accent-button text-white hover:bg-[#1554c7]': variant === 'primary',
      'bg-ink text-paper hover:bg-ink/90': variant === 'ink',
      'border border-line bg-paper text-ink hover:border-accent-brand hover:text-accent-brand': variant === 'outline',
      'border border-night-line bg-night-2 text-on-night hover:border-t-blue hover:bg-night-2/80':
        variant === 'outline-night',
    },
    className,
  ]}
>
  <slot />
</a>
