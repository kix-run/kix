---
// Section headings. "xl" is the 52px H2 most sections use, "lg" the 40px
// payoff and team headings, "md" the 22px sub-headings.
interface Props {
  as?: 'h2' | 'h3';
  size?: 'xl' | 'lg' | 'md';
  id?: string;
  class?: string;
}
const { as: Tag = 'h2', size = 'xl', id, class: className } = Astro.props;
---

<Tag
  id={id}
  class:list={[
    'font-semibold text-balance',
    {
      'text-[34px] leading-[1.08] tracking-[-1px] md:text-[44px] lg:text-[52px] lg:leading-[1.05] lg:tracking-[-1.5px]':
        size === 'xl',
      'text-[30px] leading-[1.1] tracking-[-0.75px] md:text-[40px] md:tracking-[-1px]': size === 'lg',
      'text-[20px] leading-[1.3] md:text-[22px]': size === 'md',
    },
    className,
  ]}
>
  <slot />
</Tag>
