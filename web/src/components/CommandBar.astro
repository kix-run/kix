---
import CopyButton from './CopyButton.astro';

// A one-line shell command with a copy button. "ink" sits on paper (the
// hero); "night" sits on a night section (the final call to action).
interface Props {
  command: string;
  tone?: 'ink' | 'night';
  class?: string;
}
const { command, tone = 'ink', class: className } = Astro.props;
---

<div
  class:list={[
    'flex w-full max-w-[520px] items-center justify-between gap-3 rounded-lg py-2 pr-2 pl-4 font-mono',
    tone === 'ink' ? 'bg-ink text-sm' : 'border border-night-line bg-night-2 text-[15px]',
    className,
  ]}
>
  <code class="flex min-w-0 gap-2.5 overflow-x-auto py-1.5 whitespace-nowrap">
    <span aria-hidden="true" class="text-t-dim select-none">$</span>
    <span class="text-on-night">{command}</span>
  </code>
  <CopyButton text={command} />
</div>
