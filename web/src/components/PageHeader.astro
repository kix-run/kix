---
import Container from './Container.astro';

interface Props {
  title: string;
  subtitle: string;
}
const { title, subtitle } = Astro.props;
---

<section class="architectural-well border-b border-line py-14 md:py-18">
  <Container>
    <div class="flex flex-col gap-4">
      <h1
        class="max-w-[820px] text-[38px] leading-[1.05] font-bold tracking-[-0.03em] text-balance text-ink sm:text-[48px] lg:text-[56px]"
      >
        {title}
      </h1>
      <p class="max-w-[680px] text-[18px] leading-[1.55] text-ink-2 md:text-[19px]">
        {subtitle}
      </p>
    </div>
  </Container>
</section>
