---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/sections/Nav.astro';
import PageHeader from '@/components/PageHeader.astro';
import Story from '@/components/sections/Story.astro';
import Team from '@/components/sections/Team.astro';
import Faq from '@/components/sections/Faq.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
---

<Base
  title="About & FAQ | Kix"
  description="Why we built Kix in Munich, the team behind the compiler, and answers to common questions."
>
  <Nav />
  <main id="main">
    <PageHeader
      title="Why we built Kix."
      subtitle="How running bare-metal clusters on-call and building with coding agents led us to compile Kubernetes."
    />
    <Story />
    <Team />
    <Faq />
  </main>
  <FinalCta />
</Base>
