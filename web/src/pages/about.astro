---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/sections/Nav.astro';
import PageHeader from '@/components/PageHeader.astro';
import Story from '@/components/sections/Story.astro';
import Team from '@/components/sections/Team.astro';
import Faq from '@/components/sections/Faq.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
---

<Base
  title="About & FAQ | Kix"
  description="Why we built Kix, the core team behind the compiler, and answers to common technical questions."
>
  <Nav />
  <main id="main">
    <PageHeader
      title="Built from first principles for production Kubernetes."
      subtitle="Why we replaced layers of YAML templates, overlays, and policy engines with a single cluster compiler."
    />
    <Story />
    <Team />
    <Faq />
  </main>
  <FinalCta />
</Base>
