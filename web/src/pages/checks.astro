---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/sections/Nav.astro';
import PageHeader from '@/components/PageHeader.astro';
import PayoffA from '@/components/sections/PayoffA.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
---

<Base
  title="Static Checks | Kix"
  description="Catch broken Service selectors, missing Secret keys, and workload label collisions offline in under a second."
>
  <Nav />
  <main id="main">
    <PageHeader
      title="Catch cross-resource bugs offline."
      subtitle="Kix validates the entire cluster definition before anything touches Kubernetes, catching broken selectors, missing Secret keys, and label collisions at build time."
    />
    <PayoffA />
  </main>
  <FinalCta />
</Base>
