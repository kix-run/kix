---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/sections/Nav.astro';
import PageHeader from '@/components/PageHeader.astro';
import PayoffB from '@/components/sections/PayoffB.astro';
import Deploying from '@/components/sections/Deploying.astro';
import PayoffC from '@/components/sections/PayoffC.astro';
import FinalCta from '@/components/sections/FinalCta.astro';
---

<Base
  title="Workflow, Diff & Rollouts | Kix"
  description="Preview cluster changes locally and on pull requests, deploy in dependency order, and record deployment receipts."
>
  <Nav />
  <main id="main">
    <PageHeader
      title="Preview every change before you deploy."
      subtitle="Check your cluster locally, review changes on pull requests, deploy in dependency order, and record a receipt on the cluster."
    />
    <PayoffB />
    <Deploying />
    <PayoffC />
  </main>
  <FinalCta />
</Base>
