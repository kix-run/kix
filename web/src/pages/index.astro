import PayoffsIntro from '@/components/sections/PayoffsIntro.astro';
import PayoffA from '@/components/sections/PayoffA.astro';
import PayoffB from '@/components/sections/PayoffB.astro';
import PayoffC from '@/components/sections/PayoffC.astro';
import PayoffD from '@/components/sections/PayoffD.astro';
import Packages from '@/components/sections/Packages.astro';
