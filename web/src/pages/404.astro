---
import Base from '@/layouts/Base.astro';
import Logo from '@/components/Logo.astro';
---

<Base title="Page not found | Kix" description="That page does not exist.">
  <meta slot="head" name="robots" content="noindex" />
  <main id="main" class="flex min-h-screen items-center justify-center px-6">
    <div class="flex max-w-[34rem] flex-col gap-4">
      <a href="/" class="self-start rounded-md"><Logo /><span class="sr-only"> home</span></a>
      <p class="kicker pt-6 text-ink-2">404</p>
      <h1 class="text-[40px] leading-[1.1] font-semibold tracking-[-1px] text-ink">Page not found</h1>
      <p class="text-[17px] leading-[1.6] text-ink-2">
        That page does not exist. It may have moved, or the link may be wrong.
      </p>
      <ul class="flex flex-wrap gap-6 pt-2 font-semibold text-accent-text">
        <li><a href="/" class="hover:underline">Home</a></li>
        <li><a href="/docs/" class="hover:underline">Documentation</a></li>
        <li><a href="/llms.txt" class="hover:underline">llms.txt</a></li>
      </ul>
    </div>
  </main>
</Base>
