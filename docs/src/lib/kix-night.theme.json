{
  "name": "kix-night",
  "type": "dark",
  "colors": {
    "editor.background": "#0C1117",
    "editor.foreground": "#F1F5F9"
  },
  "tokenColors": [
    {
      "settings": { "foreground": "#F1F5F9" }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#64748B", "fontStyle": "" }
    },
    {
      "scope": ["string", "string.quoted", "string.unquoted", "punctuation.definition.string", "markup.inline.raw"],
      "settings": { "foreground": "#34D399" }
    },
    {
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.other.constant",
        "entity.name.type",
        "support.type",
        "entity.name.tag.yaml"
      ],
      "settings": { "foreground": "#FBBF24" }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "keyword.operator.new"
      ],
      "settings": { "foreground": "#38BDF8" }
    },
    {
      "scope": ["markup.inserted", "punctuation.definition.inserted"],
      "settings": { "foreground": "#34D399" }
    },
    {
      "scope": ["markup.deleted", "punctuation.definition.deleted"],
      "settings": { "foreground": "#F87171" }
    },
    {
      "scope": ["markup.heading", "markup.bold"],
      "settings": { "fontStyle": "bold" }
    }
  ]
}
