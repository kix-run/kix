---
// Snippet — render a region extracted by `docs/nix/snippets.nix`.
//
// Usage:
//   import isProxy from '/src/snippets/examples/19-scorecards/scorecard/isProxy.json';
//   <Snippet {...isProxy} />
//
// Props match the JSON sidecar shape emitted by the snippet pipeline.
import { Code } from '@astrojs/starlight/components';

interface Props {
  code: string;
  childRegions?: Array<{
    name: string;
    startLine: number;
    endLine: number;
  }>;
  elide?: Record<string, string>;
  source: string;
  startLine: number;
  endLine: number;
  url: string | null;
  lang?: string;
}

const {
  code,
  childRegions = [],
  elide = {},
  source,
  startLine,
  endLine,
  url,
  lang = 'nix',
} = Astro.props;
const title = `${source} (L${startLine}–L${endLine})`;

const childByName = new Map(childRegions.map((child) => [child.name, child]));
const replacements = Object.entries(elide)
  .map(([name, replacement]) => {
    const child = childByName.get(name);
    return child ? { ...child, replacement } : null;
  })
  .filter((entry): entry is NonNullable<typeof entry> => entry !== null)
  .sort((a, b) => b.startLine - a.startLine);

const codeLines = code.split('\n');
for (const { startLine, endLine, replacement } of replacements) {
  codeLines.splice(startLine - 1, endLine - startLine + 1, replacement);
}
const renderedCode = codeLines.join('\n');
---

<Code code={renderedCode} {lang} {title} />

{url && (
  <p class="snippet-source">
    <a href={url} target="_blank" rel="noopener">
      View source on GitHub ↗
    </a>
  </p>
)}

<style>
  .snippet-source {
    margin-top: 0.5rem;
    text-align: right;
    font-size: 0.85em;
  }
  .snippet-source a {
    color: var(--sl-color-text-accent);
  }
</style>
