---
// Advertise this page's Markdown twin and the site-wide llms.txt map to
// agentic tools.
//
// Codex CLI ignores the Accept header and instead fetches the HTML and
// looks for <link rel="alternate" type="text/markdown">, so this tag is how
// Codex discovers the Markdown twin. Clients that negotiate via
// `Accept: text/markdown` (Claude Code, Cursor, Copilot, OpenCode) are
// served the `.md` twin directly by `web/public/_worker.js`.
//
// `starlight-llms-txt` emits a sibling `<page>.md` (or `/docs/index.md` for
// the docs root) for every route except 404.
import Default from '@astrojs/starlight/components/Head.astro';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const path = Astro.url.pathname.replace(/\/+$/, '');

const hasMarkdownTwin = path !== `${base}/404`;
const markdownPath = path === base ? `${base}/index.md` : `${path}.md`;
const markdownHref = hasMarkdownTwin ? new URL(markdownPath, Astro.site).href : null;
const llmsTxtHref = new URL(`${base}/llms.txt`, Astro.site).href;
---

<Default><slot /></Default>
{markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
<link rel="describedby" type="text/plain" href={llmsTxtHref} title="llms.txt" />
{/* Plausible, as on the landing page: see web/src/layouts/Base.astro. */}
{!import.meta.env.DEV && (
  <script is:inline defer data-domain="kix.run" data-api="/p/event" src="/p/script.js" />
)}
