---
// Loop: the check → build → diff → deploy → graph strip, as bordered cells.
//
// Usage: wrap a Markdown ordered list whose items start with the command.
//
//   <Loop>
//   1. `kix check` validate the evaluated cluster
//   2. `kix build` see the rendered resources
//   </Loop>
import { parseListRows } from '../lib/list-rows';

const rows = parseListRows(await Astro.slots.render('default'));
---

<ol class="kix-loop not-content" style={`--loop-steps: ${rows.length}`}>
  {
    rows.map((row) => (
      <li>
        {row.command && <span class="command" set:html={row.command} />}
        <span class="text" set:html={row.text} />
      </li>
    ))
  }
</ol>

<style>
  .kix-loop {
    display: grid;
    grid-template-columns: repeat(var(--loop-steps), minmax(0, 1fr));
    margin: 1.25rem 0 0;
    border: 1px solid var(--kix-line);
    border-radius: 8px;
    padding: 0;
    list-style: none;
    overflow: hidden;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    padding: 0.875rem 0.875rem 1rem;
  }
  li + li {
    border-inline-start: 1px solid var(--kix-line);
  }
  .command {
    color: var(--kix-ink);
    font-family: var(--__sl-font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .command :global(code) {
    font-family: inherit;
  }
  .text {
    color: var(--kix-ink-2);
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  @media (max-width: 40rem) {
    .kix-loop {
      grid-template-columns: 1fr;
    }
    li {
      flex-direction: row;
      align-items: baseline;
      gap: 1rem;
      padding: 0.625rem 0.875rem;
    }
    li + li {
      border-inline-start: 0;
      border-top: 1px solid var(--kix-line);
    }
    .command {
      flex: none;
      width: 6.5rem;
    }
  }
</style>
