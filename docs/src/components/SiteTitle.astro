---
// Sovereign Navy "kix" wordmark badge and "/docs" suffix.
// Replaces Starlight's default text title.
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="site-title">
  <a href="/" class="home-link" aria-label="Kix home">
    <span class="badge" translate="no">kix</span>
  </a>
  <a href={siteTitleHref} class="suffix" aria-label="Kix docs home" translate="no">/docs</a>
</div>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    white-space: nowrap;
  }
  .home-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #212d3b;
    border-radius: 5px;
    padding: 0.25rem 0.625rem;
    background-color: #0c1117;
    color: #ffffff;
    font-family: var(--__sl-font-mono);
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }
  :global(:root:not([data-theme='light'])) .badge {
    border-color: rgba(56, 189, 248, 0.35);
    background-color: #1d65ec;
  }
  .suffix {
    color: var(--kix-ink-2);
    font-family: var(--__sl-font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }
  .suffix:hover {
    color: var(--kix-ink);
  }
</style>
