---
// Logo mark (ink square with an orange mono "k"), the "kix" wordmark and a
// "/docs" suffix. Replaces Starlight's default text title.
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<div class="site-title">
  <a href="/" class="home-link" aria-label="Kix home">
    <span class="mark" aria-hidden="true">k</span>
    <span class="wordmark" translate="no">kix</span>
  </a>
  <a href={siteTitleHref} class="suffix" aria-label="Kix docs home" translate="no">/docs</a>
</div>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
    white-space: nowrap;
  }
  .home-link {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
  }
  .mark {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 6px;
    background-color: var(--kix-ink);
    color: var(--kix-brand);
    font-family: var(--__sl-font-mono);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
  }
  :global(:root:not([data-theme='light'])) .mark {
    background-color: var(--kix-paper-2);
    box-shadow: inset 0 0 0 1px var(--kix-line);
  }
  .wordmark {
    color: var(--kix-ink);
    font-family: var(--__sl-font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .suffix {
    color: var(--kix-ink-2);
    font-family: var(--__sl-font-mono);
    font-size: 0.9375rem;
    text-decoration: none;
  }
  .suffix:hover {
    color: var(--kix-ink);
  }
</style>
