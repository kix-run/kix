---
// Wordmark matching the homepage logo (web/src/components/landing/Nav.tsx):
// mono lowercase "kix" with a brand dot at the baseline, plus a muted
// "docs" suffix. Replaces Starlight's default text title.
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <span class="wordmark" translate="no">kix</span>
  <span class="dot"></span>
  <span class="suffix">docs</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    min-width: 0;
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xl);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--sl-color-white);
  }
  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background-color: var(--sl-color-accent);
  }
  .suffix {
    margin-inline-start: 0.25rem;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-base);
    color: var(--sl-color-gray-3);
  }
</style>
