---
// Replaces Starlight's default ThemeSelect (a select dropdown labelled
// "Auto" with a laptop icon) with three explicit icon buttons —
// Light / Dark / Auto. Behaviour mirrors the upstream component:
// localStorage key `starlight-theme` stores 'light' | 'dark' | ''
// (empty = auto); `<html data-theme>` carries the resolved theme.
//
// starlight-versions normally overrides ThemeSelect to inject its
// version switcher. When we override ThemeSelect ourselves the plugin
// bows out and warns; we restore the switcher by rendering
// VersionSelect inline here, matching the plugin's own override shape.
import VersionSelect from 'starlight-versions/components/VersionSelect.astro';
---

<VersionSelect />
<starlight-theme-toggle role="group" aria-label="Theme">
  <button type="button" data-theme-value="light" aria-label="Light theme" title="Light">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
    </svg>
  </button>
  <button type="button" data-theme-value="dark" aria-label="Dark theme" title="Dark">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
    </svg>
  </button>
  <button type="button" data-theme-value="auto" aria-label="Auto theme (match system)" title="Auto">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 2v2"></path>
      <path d="M14.837 16.385a6 6 0 1 1-7.223-7.222c.624-.147.97.66.715 1.248a4 4 0 0 0 5.26 5.259c.589-.255 1.396.09 1.248.715"></path>
      <path d="M16 12a4 4 0 0 0-4-4"></path>
      <path d="m19 5-1.256 1.256"></path>
      <path d="M20 12h2"></path>
    </svg>
  </button>
</starlight-theme-toggle>

<style>
  starlight-theme-toggle {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    padding: 2px;
    gap: 1px;
  }
  starlight-theme-toggle button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-3);
    cursor: pointer;
  }
  starlight-theme-toggle button:hover {
    color: var(--sl-color-white);
  }
  starlight-theme-toggle button[aria-pressed='true'] {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-white);
  }
</style>

<script>
  type Theme = 'auto' | 'dark' | 'light';

  const storageKey = 'starlight-theme';

  const parseTheme = (theme: unknown): Theme =>
    theme === 'auto' || theme === 'dark' || theme === 'light' ? theme : 'auto';

  const loadTheme = (): Theme =>
    parseTheme(typeof localStorage !== 'undefined' && localStorage.getItem(storageKey));

  function storeTheme(theme: Theme): void {
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem(storageKey, theme === 'light' || theme === 'dark' ? theme : '');
    }
  }

  const getPreferredColorScheme = (): 'light' | 'dark' =>
    matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';

  function applyTheme(theme: Theme): void {
    document.documentElement.dataset.theme = theme === 'auto' ? getPreferredColorScheme() : theme;
    storeTheme(theme);
    for (const el of document.querySelectorAll<HTMLElement>('starlight-theme-toggle button[data-theme-value]')) {
      el.setAttribute('aria-pressed', String(el.dataset.themeValue === theme));
    }
  }

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (loadTheme() === 'auto') applyTheme('auto');
  });

  class StarlightThemeToggle extends HTMLElement {
    constructor() {
      super();
      applyTheme(loadTheme());
      for (const button of this.querySelectorAll<HTMLButtonElement>('button[data-theme-value]')) {
        button.addEventListener('click', () => {
          applyTheme(parseTheme(button.dataset.themeValue));
        });
      }
    }
  }
  customElements.define('starlight-theme-toggle', StarlightThemeToggle);
</script>
