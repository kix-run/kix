---
// Starlight renders ThemeSelect in the mobile menu footer (the desktop
// header is src/components/Header.astro). Overriding ThemeSelect displaces
// starlight-versions' own override, so VersionSelect is rendered here too.
import VersionSelect from 'starlight-versions/components/VersionSelect.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<div class="theme-select">
  <VersionSelect />
  <ThemeToggle />
</div>

<style>
  .theme-select {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
</style>
