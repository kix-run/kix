---
// Page footer: pagination, then a hairline and the last-updated date.
// The design's "Edit this page" and "Report a problem" links are left out
// until the docs have a public edit and issue target (decision D7).
import Pagination from 'virtual:starlight/components/Pagination';

const { lang, lastUpdated } = Astro.locals.starlightRoute;
---

<footer class="kix-footer">
  <Pagination />
  <div class="meta">
    {
      lastUpdated ? (
        <span>
          Updated{' '}
          <time datetime={lastUpdated.toISOString()}>
            {lastUpdated.toLocaleDateString(lang, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })}
          </time>
        </span>
      ) : (
        <span></span>
      )
    }
    <span>
      Co-created by <a href="https://lithus.eu" class="lithus-link">Lithus</a>
    </span>
  </div>
</footer>

<style>
  .kix-footer {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 3.5rem;
  }
  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    border-top: 1px solid var(--kix-line);
    padding-top: 1.25rem;
    color: var(--kix-dim);
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
  }
  .lithus-link {
    color: var(--kix-ink-2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .lithus-link:hover {
    color: var(--kix-ink);
  }
</style>
