---
// Command: terminal-style block for one or more shell commands and their
// captured output. Canonical way to show commands in the docs.
//
// API:
//   commands: (string | Step)[]
//     A bare string entry renders as a command line with no output.
//     A Step object can carry stdout / stderr / exitCode captured against a
//     real run, plus a per-step `cwd` override.
//   cwd?: string:       working directory shown in the terminal chrome.
//   title?: string:     overrides the chrome label (defaults to `cwd`; with
//                        neither, the block has no chrome row).
//   expandable?: boolean
//     When set, output is collapsed inside a <details> disclosure. The
//     command lines remain visible.
//
// Examples:
//   <Command commands={["kix list clusters"]} cwd="kix-examples/" />
//
//   <Command commands={[
//     "kubectl get pods -n tutorial-04",
//     "kubectl get svc -n tutorial-04",
//   ]} />
//
//   <Command {...checkOutput} />     // sidecar JSON spread directly
//
//   <Command expandable {...deployFirst} />

import { parseAnsi, styleToCss, type Span } from '/src/lib/ansi.ts';

export interface Step {
  command: string;
  cwd?: string;
  stdout?: string;
  stderr?: string;
  exitCode?: number;
}

interface Props {
  commands: (string | Step)[];
  cwd?: string;
  title?: string;
  expandable?: boolean;
  /**
   * Generator tag carried by spread sidecar JSON: `"offline"` or `"live"`.
   * When present, the author signalled "this block shows generated output":
   * if every step is empty we treat that as a build error rather than a
   * silent blank box. Sidecar JSON sets this field; hand-written
   * `<Command commands={[...]} />` invocations omit it.
   */
  generator?: 'offline' | 'live';
  /** The stored output is a capture-time excerpt of the command's stdout. */
  outputExcerpt?: boolean;
  /**
   * Sidecar id (e.g. `tutorials/02-hello-world/list-clusters`). Used only
   * for diagnostics: included in any thrown error so the maintainer can
   * trace the failing sidecar back to its manifest entry.
   */
  id?: string;
}

const { commands, cwd, title, expandable = false, generator, id, outputExcerpt = false } = Astro.props;

type NormalisedStep = Required<Pick<Step, 'command'>> &
  Pick<Step, 'cwd' | 'stdout' | 'stderr' | 'exitCode'>;

const steps: NormalisedStep[] = commands.map((entry) => {
  if (typeof entry === 'string') return { command: entry };
  return entry;
});

const terminalLabel = title ?? cwd ?? null;
const captureLabel = generator ? `${generator} capture` : null;

// Missing-output detection: prevent silent blank-output regressions.
// `expandable` and spread sidecars (identified by the `generator` tag)
// both imply the author expects output. If every step is empty, fail loud
// at build time with a pointer to the manifest entry / call site.
const stepHasOutput = (s: NormalisedStep): boolean =>
  Boolean((s.stdout ?? '').length || (s.stderr ?? '').length) ||
  (s.exitCode ?? 0) !== 0;

if (expandable && !steps.some(stepHasOutput)) {
  throw new Error(
    `<Command expandable> requires at least one step with output, ` +
    `but every step in this block is empty. ` +
    (id ? `Sidecar id: ${id}. ` : '') +
    `Either drop \`expandable\`, hardcode a step's stdout, or add the ` +
    `command to docs/nix/captures.nix ` +
    `and rebuild.`,
  );
}
if (generator && !steps.some(stepHasOutput)) {
  throw new Error(
    `<Command> was spread from a "${generator}" sidecar` +
    (id ? ` (${id})` : '') +
    `, but every captured step is empty. ` +
    `If the command really produces no output, drop the sidecar and use ` +
    `a bare \`commands={["..."]}\`. Otherwise check the manifest entry ` +
    `under docs/nix/.`,
  );
}

// Command line tokenization: first word + flags get the "command" colour;
// remaining words are "argument" colour. Whitespace preserved verbatim.
type TokenKind = 'command' | 'argument' | 'space';
interface Token { token: string; kind: TokenKind; }

function tokenizeCommandLine(line: string): Token[] {
  let wordIndex = -1;
  const tokens: Token[] = [];
  for (const piece of line.split(/(\s+)/)) {
    if (piece === '') continue;
    if (/^\s+$/.test(piece)) {
      tokens.push({ token: piece, kind: 'space' });
      continue;
    }
    wordIndex += 1;
    const kind: TokenKind =
      wordIndex === 0 || piece.startsWith('-') ? 'command' : 'argument';
    tokens.push({ token: piece, kind });
  }
  return tokens;
}

function tokenizeCommand(command: string): Token[][] {
  return command.replace(/\s+$/u, '').split('\n').map(tokenizeCommandLine);
}

// Output rendering: ANSI parse → styled spans. Each span carries a stable
// style key so we can render with classes (named colours) and inline
// declarations only for 24-bit / 256-colour fallbacks.
function renderOutput(stdout: string, stderr: string, exitCode: number): Span[] {
  const stdoutClean = stdout.replace(/\s+$/u, '');
  const stderrClean = stderr.replace(/\s+$/u, '');
  const joined = [stdoutClean, stderrClean].filter(Boolean).join('\n');
  const exitTail = exitCode !== 0 ? `\n(exit code: ${exitCode})` : '';
  return parseAnsi(joined + exitTail);
}

// Pre-compute flat render-node lists. Astro's template compiler only accepts
// expression-bodied arrow functions (no block bodies, no early returns) in
// `{...}` expressions, so we keep the template a simple .map() chain and
// shape everything into ready-to-render data here. See
// https://github.com/withastro/astro/issues/6955 for the restriction.

// Each step renders as either a `<pre>` (command lines + optional inline
// output, the default) or, when `expandable` is set and the step has output,
// a `<pre>` of command lines followed by a `<details>` whose summary is the
// "Show output · N lines" row and whose body is the output. Sibling units
// render visually contiguous via the adjacency CSS rules below.
//
// Astro's template compiler only accepts expression-bodied arrow functions
// in `{...}` expressions, and trips up on nested ternaries returning JSX.
// So per-step content is normalised in the script into a flat shape: a
// list of `LineItem`s, each one wrap-span (`command-line` or `output`) +
// a sequence of `InnerSpan`s. The template walks the shape with at most
// one ternary level (PreUnit vs DetailsUnit).
type InnerSpan = { text: string; classes: string; style: string };
type LineItem = {
  wrapClass: string;       // 'command-line' or 'output'
  leadingNewline: boolean; // emit a leading '\n' before this item's content
  spans: InnerSpan[];
};
type PreUnit = { kind: 'pre'; items: LineItem[] };
// Expandable step: command lines stay visible above the <details>; the
// output lives inside it. `lineCount` labels the disclosure row.
type DetailsUnit = {
  kind: 'details';
  commandItems: LineItem[];
  output: InnerSpan[];
  lineCount: number;
};
type RenderUnit = PreUnit | DetailsUnit;

function buildOutputSpans(stdout: string, stderr: string, exitCode: number): InnerSpan[] {
  const parsed = renderOutput(stdout, stderr, exitCode);
  return parsed.map((span) => {
    const css = styleToCss(span.style);
    return { text: span.text, classes: css.classes.join(' '), style: css.inline };
  });
}

function commandLineToItem(tokens: Token[], leadingNewline: boolean): LineItem {
  const spans: InnerSpan[] = [
    { text: '❱', classes: 'prompt', style: '' },
    { text: ' ', classes: '', style: '' },
    ...tokens.map((t) => ({
      text: t.token,
      classes: t.kind === 'space' ? '' : t.kind,
      style: '',
    })),
  ];
  return { wrapClass: 'command-line', leadingNewline, spans };
}

// Text for the copy button: every command, one per line.
const copyText = steps.map((step) => step.command.replace(/\s+$/u, '')).join('\n');

const units: RenderUnit[] = [];

for (const step of steps) {
  const lines = tokenizeCommand(step.command);
  const stdout = step.stdout ?? '';
  const stderr = step.stderr ?? '';
  const exitCode = step.exitCode ?? 0;
  const hasOutput = Boolean(stdout || stderr) || exitCode !== 0;
  const outputSpans = hasOutput ? buildOutputSpans(stdout, stderr, exitCode) : [];

  const items: LineItem[] = lines.map((tokens, lineIdx) =>
    commandLineToItem(tokens, lineIdx > 0),
  );

  if (hasOutput && expandable) {
    const lineCount = outputSpans.map((span) => span.text).join('').split('\n').length;
    units.push({ kind: 'details', commandItems: items, output: outputSpans, lineCount });
  } else {
    if (hasOutput) {
      items.push({ wrapClass: 'output', leadingNewline: true, spans: outputSpans });
    }
    units.push({ kind: 'pre', items });
  }
}
---

<figure class:list={["command-block not-content", { "has-chrome": terminalLabel }]}>
  {terminalLabel ? (
    <figcaption>
      <span class="terminal-label">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"></path></svg>
        <span>{terminalLabel}</span>
      </span>
      <span class="terminal-tags">
        {outputExcerpt && <span class="terminal-tag">output excerpt</span>}
        {captureLabel && expandable && <span class="terminal-tag capture-tag">{captureLabel}</span>}
        <button type="button" class="copy" data-command-copy={copyText} aria-label="Copy command" title="Copy command">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
        </button>
      </span>
    </figcaption>
  ) : (
    <button type="button" class="copy floating" data-command-copy={copyText} aria-label="Copy command" title="Copy command">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
    </button>
  )}
  {!terminalLabel && outputExcerpt && <span class="terminal-tag floating-tag">output excerpt</span>}
  {units.map((unit) => (
    unit.kind === 'pre' ? (
      <pre><code>{unit.items.map((item) => (
        <span class={item.wrapClass}>{item.leadingNewline ? '\n' : ''}{item.spans.map((s) => (
          <span class={s.classes} style={s.style || undefined}>{s.text}</span>
        ))}</span>
      ))}</code></pre>
    ) : (
      <div class="command-step">
        <pre class="disclosure-command"><code>{unit.commandItems.map((item) => (
          <span class={item.wrapClass}>{item.leadingNewline ? '\n' : ''}{item.spans.map((s) => (
            <span class={s.classes} style={s.style || undefined}>{s.text}</span>
          ))}</span>
        ))}</code></pre>
        <details class="command-block-disclosure not-content">
          <summary>
            <svg class="chevron" aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
            <span class="disclosure-toggle"><span class="when-closed">Show output</span><span class="when-open">Hide output</span></span>
            <span class="line-count">· {unit.lineCount} {unit.lineCount === 1 ? 'line' : 'lines'}</span>
          </summary>
          <pre class="output-pre"><code><span class="output">{unit.output.map((s) => (
            <span class={s.classes} style={s.style || undefined}>{s.text}</span>
          ))}</span></code></pre>
        </details>
      </div>
    )
  ))}
</figure>

<style>
  /* A night panel in both themes. Colours come from the --kix-* tokens in
     src/styles/kix.css, including the --ansi-* palette used by the
     ansi-fg-* and ansi-bg-* classes below. */
  .command-block {
    position: relative;
    margin: 1.25rem 0 0;
    border: 1px solid var(--kix-code-line);
    border-radius: 10px;
    background: var(--kix-code-bg);
    color: var(--kix-on-night);
    overflow: hidden;
  }
  .command-block figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2.375rem;
    padding: 0.375rem 0.75rem 0.375rem 1rem;
    border-bottom: 1px solid var(--kix-code-line);
    color: var(--kix-on-night-2);
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
  }
  .terminal-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .terminal-label svg {
    flex: none;
    color: var(--kix-on-night-dim);
  }
  .terminal-tags {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .terminal-tag {
    border: 1px solid var(--kix-code-line);
    border-radius: 4px;
    padding: 0.0625rem 0.4375rem;
    color: var(--kix-on-night-2);
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    white-space: nowrap;
  }
  /* The capture tag describes the output, so it shows only while output is
     visible. */
  .command-block:not(:has(details[open])) .capture-tag {
    display: none;
  }
  .floating-tag {
    position: absolute;
    top: 0.625rem;
    inset-inline-end: 2.75rem;
  }
  .copy {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 0;
    border-radius: 6px;
    padding: 0;
    background: transparent;
    color: var(--kix-on-night-2);
    cursor: pointer;
  }
  .copy:hover {
    background: var(--kix-code-chrome);
    color: var(--kix-on-night);
  }
  .copy[data-copied] {
    color: var(--kix-t-green);
  }
  .copy.floating {
    position: absolute;
    top: 0.5rem;
    inset-inline-end: 0.5rem;
    z-index: 1;
  }
  .command-block pre {
    margin: 0;
    border: 0;
    padding: 0.875rem 1.125rem;
    overflow-x: auto;
    background: transparent;
    color: var(--kix-on-night);
    font-size: 0.84375rem;
    line-height: 1.6;
  }
  .command-block:not(.has-chrome) > pre:first-of-type,
  .command-block:not(.has-chrome) > .command-step:first-of-type > pre {
    padding-inline-end: 3rem;
  }
  .command-block code {
    font-family: var(--__sl-font-mono);
  }
  .command,
  .argument {
    color: var(--kix-on-night);
  }
  .prompt {
    color: var(--kix-brand);
  }
  .output {
    color: var(--kix-on-night-2);
  }

  /* Expandable output: the command stays visible; a disclosure row on the
     chrome colour reveals the output below it. */
  .command-block-disclosure {
    margin: 0;
    border: 0;
    padding: 0;
    background: transparent;
  }
  .command-block-disclosure > summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    border-top: 1px solid var(--kix-code-line);
    padding: 0.5rem 1.125rem;
    background: var(--kix-code-chrome);
    color: var(--kix-on-night);
    cursor: pointer;
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    list-style: none;
    user-select: none;
  }
  .command-block-disclosure > summary::-webkit-details-marker,
  .command-block-disclosure > summary::marker {
    display: none;
    content: '';
  }
  .command-block-disclosure > summary::before {
    display: none;
  }
  .command-block-disclosure > summary:hover .disclosure-toggle {
    text-decoration: underline;
  }
  .chevron {
    flex: none;
    color: var(--kix-on-night-2);
    transition: transform 0.15s ease;
  }
  .command-block-disclosure[open] .chevron {
    transform: rotate(90deg);
  }
  .when-open,
  .command-block-disclosure[open] .when-closed {
    display: none;
  }
  .command-block-disclosure[open] .when-open {
    display: inline;
  }
  .line-count {
    color: var(--kix-on-night-dim);
  }
  .command-block-disclosure[open] > summary {
    border-bottom: 1px solid var(--kix-code-line);
  }
  .output-pre {
    padding-top: 0.75rem;
  }

  /* Consecutive steps read as one terminal session: tighten the padding
     between them. */
  .command-block > pre + pre {
    padding-top: 0.125rem;
  }
  .command-block > pre:has(+ pre) {
    padding-bottom: 0.125rem;
  }
  .command-step + .command-step,
  .command-block > pre + .command-step,
  .command-step + pre {
    border-top: 1px solid var(--kix-code-line);
  }

  @media (prefers-reduced-motion: reduce) {
    .chevron {
      transition: none;
    }
  }

  .ansi-fg-black { color: var(--ansi-black); }
  .ansi-fg-red { color: var(--ansi-red); }
  .ansi-fg-green { color: var(--ansi-green); }
  .ansi-fg-yellow { color: var(--ansi-yellow); }
  .ansi-fg-blue { color: var(--ansi-blue); }
  .ansi-fg-magenta { color: var(--ansi-magenta); }
  .ansi-fg-cyan { color: var(--ansi-cyan); }
  .ansi-fg-white { color: var(--ansi-white); }
  .ansi-fg-bright-black { color: var(--ansi-bright-black); }
  .ansi-fg-bright-red { color: var(--ansi-bright-red); }
  .ansi-fg-bright-green { color: var(--ansi-bright-green); }
  .ansi-fg-bright-yellow { color: var(--ansi-bright-yellow); }
  .ansi-fg-bright-blue { color: var(--ansi-bright-blue); }
  .ansi-fg-bright-magenta { color: var(--ansi-bright-magenta); }
  .ansi-fg-bright-cyan { color: var(--ansi-bright-cyan); }
  .ansi-fg-bright-white { color: var(--ansi-bright-white); }

  .ansi-bg-black { background-color: var(--ansi-black); }
  .ansi-bg-red { background-color: var(--ansi-red); }
  .ansi-bg-green { background-color: var(--ansi-green); }
  .ansi-bg-yellow { background-color: var(--ansi-yellow); }
  .ansi-bg-blue { background-color: var(--ansi-blue); }
  .ansi-bg-magenta { background-color: var(--ansi-magenta); }
  .ansi-bg-cyan { background-color: var(--ansi-cyan); }
  .ansi-bg-white { background-color: var(--ansi-white); }
  .ansi-bg-bright-black { background-color: var(--ansi-bright-black); }
  .ansi-bg-bright-red { background-color: var(--ansi-bright-red); }
  .ansi-bg-bright-green { background-color: var(--ansi-bright-green); }
  .ansi-bg-bright-yellow { background-color: var(--ansi-bright-yellow); }
  .ansi-bg-bright-blue { background-color: var(--ansi-bright-blue); }
  .ansi-bg-bright-magenta { background-color: var(--ansi-bright-magenta); }
  .ansi-bg-bright-cyan { background-color: var(--ansi-bright-cyan); }
  .ansi-bg-bright-white { background-color: var(--ansi-bright-white); }

  .ansi-bold { font-weight: 700; }
  .ansi-dim { opacity: 0.65; }
  .ansi-italic { font-style: italic; }
  .ansi-underline { text-decoration: underline; }
  .ansi-strikethrough { text-decoration: line-through; }
  .ansi-inverse { filter: invert(1); }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-command-copy]')) {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.commandCopy ?? '');
        button.dataset.copied = '';
        setTimeout(() => delete button.dataset.copied, 1500);
      } catch (error) {
        console.error(error);
      }
    });
  }
</script>
