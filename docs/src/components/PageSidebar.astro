---
// Right rail: "On this page" and the page actions. Under 72rem Starlight's
// mobile "On this page" dropdown replaces it, and the actions are dropped.
//
// Copy as Markdown fetches the page's `.md` twin, which starlight-llms-txt
// and starlight-page-actions emit for every page except 404.
import MobileTableOfContents from 'virtual:starlight/components/MobileTableOfContents';
import TableOfContents from 'virtual:starlight/components/TableOfContents';

const { toc } = Astro.locals.starlightRoute;
const path = Astro.url.pathname.replace(/\/+$/, '');
---

{
  toc && (
    <>
      <div class="lg:sl-hidden">
        <MobileTableOfContents />
      </div>
      <div class="right-sidebar-panel sl-hidden lg:sl-block">
        <div class="sl-container kix-rail">
          <TableOfContents />
          <div class="actions">
            <button type="button" class="action" data-copy-markdown={path}>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
              </svg>
              <span data-label>Copy as Markdown</span>
            </button>
          </div>
        </div>
      </div>
    </>
  )
}

<style>
  .right-sidebar-panel {
    padding: var(--kix-article-top, 3rem) 2rem 2rem 0;
  }
  .sl-container {
    width: 100%;
    max-width: none;
  }
  .kix-rail :global(h2) {
    margin-bottom: 0.875rem;
    color: var(--kix-ink-2);
    font-family: var(--__sl-font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.11em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .kix-rail :global(starlight-toc > nav > ul) {
    border-inline-start: 1px solid var(--kix-line);
  }
  .kix-rail :global(starlight-toc ul ul) {
    margin-inline-start: 0.75rem;
  }
  .kix-rail :global(starlight-toc a) {
    margin-inline-start: -1px;
    border-inline-start: 2px solid transparent;
    border-radius: 0;
    padding: 0.3125rem 0 0.3125rem 0.875rem;
    color: var(--kix-ink-2);
    font-size: 0.8125rem;
    line-height: 1.35;
    text-decoration: none;
  }
  .kix-rail :global(starlight-toc a:hover) {
    color: var(--kix-ink);
  }
  .kix-rail :global(starlight-toc a[aria-current='true']) {
    border-inline-start-color: var(--kix-brand);
    color: var(--kix-ink);
    font-weight: 600;
  }

  .actions {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: 1.25rem;
    border-top: 1px solid var(--kix-line);
    padding-top: 1.25rem;
  }
  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 0;
    padding: 0;
    background: none;
    color: var(--kix-ink-2);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .action:hover {
    color: var(--kix-ink);
  }
</style>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-markdown]')) {
    const label = button.querySelector<HTMLElement>('[data-label]');
    const idle = label?.textContent ?? '';
    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        const res = await fetch(`${button.dataset.copyMarkdown}.md`);
        if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
        await navigator.clipboard.writeText(await res.text());
        if (label) label.textContent = 'Copied';
      } catch (error) {
        console.error(error);
        if (label) label.textContent = 'Copy failed';
      } finally {
        button.disabled = false;
        setTimeout(() => {
          if (label) label.textContent = idle;
        }, 2000);
      }
    });
  }
</script>
