---
// Two-row docs header. The top bar holds the logo, search, version picker,
// GitHub link, theme control and the install link; the second row holds the
// Diátaxis topic tabs from the vendored starlight-sidebar-topics plugin.
//
// Under 50rem the header is a single row (logo and search). The version
// picker and theme control move to Starlight's mobile menu footer
// (ThemeSelect.astro), and the topics to the top of the menu
// (src/lib/sidebar-topics/overrides/Sidebar.astro).
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import VersionSelect from './VersionSelect.astro';
import ThemeToggle from './ThemeToggle.astro';

const topics = Astro.locals.starlightSidebarTopics?.topics ?? [];
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const installHref = `${base}/tutorials/02-local-setup-and-first-run/`;
---

<div class="kix-header">
  <div class="top-bar">
    <div class="brand">
      <SiteTitle />
      <div class="search print:hidden"><Search /></div>
    </div>
    <div class="actions sl-hidden md:sl-flex print:hidden">
      <div class="version"><VersionSelect /></div>
      <a class="github" href="https://github.com/kix-run/kixpkgs" aria-label="Kix on GitHub">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>
      <ThemeToggle />
      <a class="install" href={installHref}>Install the CLI</a>
    </div>
  </div>
  {
    topics.length > 0 && (
      <nav class="topic-tabs sl-hidden md:sl-flex print:hidden" aria-label="Documentation sections">
        {topics.map((topic) => (
          <a
            href={topic.link}
            aria-current={
              topic.isCurrent || (topic.link.replace(/\/+$/, '') || '/') === pathname
                ? 'true'
                : undefined
            }
          >
            {topic.label}
          </a>
        ))}
      </nav>
    )
  }
</div>

<style>
  .kix-header {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 100%;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    min-width: 0;
  }
  .actions {
    align-items: center;
    gap: 1.25rem;
  }
  .github {
    display: inline-flex;
    color: var(--kix-ink-2);
  }
  .github:hover {
    color: var(--kix-ink);
  }
  .install {
    border-radius: 8px;
    padding: 0.5rem 0.875rem;
    background-color: var(--kix-cta-bg);
    color: var(--kix-cta-fg);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
  }
  .install:hover {
    opacity: 0.88;
  }

  /* The version picker, restyled to the bordered mono control. */
  .version :global(label) {
    border: 1px solid var(--kix-line);
    border-radius: 6px;
    color: var(--kix-ink);
  }
  .version :global(.label-icon) {
    display: none;
  }
  .version :global(select) {
    width: auto;
    padding-block: 0.3125rem;
    padding-inline: 0.625rem 1.75rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
  }
  .version :global(.caret-icon) {
    inset-inline-end: 0.375rem;
    color: var(--kix-ink-2);
    font-size: 1rem;
  }

  @media (min-width: 50rem) {
    .top-bar {
      flex: none;
      height: var(--kix-topbar-height);
      padding-inline: var(--sl-nav-pad-x);
    }
  }

  .topic-tabs {
    flex: none;
    align-items: stretch;
    gap: 2rem;
    height: var(--kix-tabs-height);
    padding-inline: var(--sl-nav-pad-x);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .topic-tabs a {
    display: flex;
    align-items: center;
    border-bottom: 2px solid transparent;
    padding-top: 0.125rem;
    color: var(--kix-ink-2);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .topic-tabs a:hover {
    color: var(--kix-ink);
  }
  .topic-tabs a[aria-current='true'] {
    border-bottom-color: var(--kix-brand);
    color: var(--kix-ink);
    font-weight: 600;
  }
</style>
