{
  "endpoints": [
    {
      "bearerTokenFile": "/var/run/secrets/kubernetes.io/serviceaccount/token",
      "port": "http-metrics"
    }
  ],
  "jobLabel": "jobLabel",
  "namespaceSelector": {
    "matchNames": [
      "kube-system"
    ]
  },
  "selector": {
    "matchLabels": {
      "app": "kube-prometheus-stack-kube-proxy",
      "release": "prometheus"
    }
  }
}
