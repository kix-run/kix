{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cargo_target_guard.py\"",
            "timeout": 15,
            "statusMessage": "Checking cargo target dir…"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/nix_store_guard.py\"",
            "timeout": 60,
            "statusMessage": "Checking Nix store headroom…"
          }
        ]
      }
    ]
  }
}
