{
  "claimedNamespaces": [],
  "clusterScoped": [],
  "consumer": "acme",
  "facts": {
    "capabilities": {
      "availabilityZones": null,
      "daemonSets": null,
      "gpu": null,
      "managedControlPlane": null,
      "multiNode": null,
      "nodeAutoscaling": null,
      "podSecurityEnforcement": null,
      "privilegedContainers": null
    },
    "clusterDomain": "cluster.local",
    "k8sVersion": null,
    "networkPolicy": false,
    "provider": null
  },
  "namespaces": {
    "acme-*": {
      "max": 5,
      "podSecurity": "baseline",
      "quota": {
        "pods": "20"
      },
      "secrets": []
    }
  },
  "platform": "test-platform",
  "platformNamespaces": [
    "kube-system",
    "platform"
  ],
  "secretsRecipient": null,
  "services": {
    "platform/api": {
      "instance": "api",
      "namespace": "platform",
      "out": {
        "fqdn": "api.platform.svc.cluster.local",
        "name": "api",
        "ports": [
          {
            "name": "http",
            "port": 80,
            "targetPort": "http"
          }
        ],
        "selector": {
          "app.kubernetes.io/instance": "api",
          "app.kubernetes.io/managed-by": "kix"
        }
      },
      "roles": []
    }
  },
  "version": 2
}
